+"""Direct Claude Messages API adapter for the existing first-stage contract."""
+
+import os
+from typing import Any, Literal, cast
+
+import anthropic
+from anthropic.types import Message, MessageParam, ToolParam
+
+import line_messaging
+from markdown_to_line import render_to_line
+
+ANTHROPIC_API_KEY_NAME = os.environ.get("ANTHROPIC_API_KEY_NAME", "")
+CLAUDE_MODEL = os.environ.get("CLAUDE_MODEL") or "claude-haiku-5-5"
+CLAUDE_EFFORT = os.environ.get("CLAUDE_EFFORT") or "low"
+CLAUDE_MAX_TOKENS = os.environ.get("CLAUDE_MAX_TOKENS") or "2000"
+ClaudeEffort = Literal["low", "medium", "high", "xhigh", "max"]
+
+_client: anthropic.Anthropic | None = None
+
+
+def get_claude_client() -> anthropic.Anthropic:
+    """Cache the client only after rejecting missing and dummy credentials."""
+    global _client
+    if _client is None:
+        if not ANTHROPIC_API_KEY_NAME:
+            raise ValueError("ANTHROPIC_API_KEY_NAME is not configured")
+        key = line_messaging.get_secret(ANTHROPIC_API_KEY_NAME).strip()
+        if not key or any(
+            marker in key.lower()
+            for marker in ("placeholder", "dummy", "replace", "your_api_key", "xxxx")
+        ):
+            raise ValueError("ANTHROPIC_API_KEY is missing or a placeholder")
+        _client = anthropic.Anthropic(
+            api_key=key,
+            base_url="https://api.anthropic.com",
+            timeout=30.0,
+            max_retries=0,
+            http_client=anthropic.DefaultHttpxClient(follow_redirects=False),
+        )
+    return _client
+
+
+def get_claude_response(api_messages: list[dict], tools: list[dict]) -> dict[str, Any]:
+    """Make one request, preserving the prompt/history and Grok search contract.
+
+    Claude accepts the initial system prompt separately from user/assistant
+    history. Client tool use is handed to the existing Grok stage; there is no
+    tool-result round trip back to Claude.
+    """
+    if CLAUDE_EFFORT not in ("low", "medium", "high", "xhigh", "max"):
+        raise ValueError("Invalid CLAUDE_EFFORT")
+    max_tokens = int(CLAUDE_MAX_TOKENS)
+    if not 1 <= max_tokens <= 128000:
+        raise ValueError("Invalid CLAUDE_MAX_TOKENS")
+    if (
+        len(api_messages) < 2
+        or api_messages[0].get("role") != "system"
+        or api_messages[-1].get("role") != "user"
+        or any(message.get("role") not in ("user", "assistant") for message in api_messages[1:])
+        or any(not isinstance(message.get("content"), str) for message in api_messages)
+    ):
+        raise ValueError("Invalid Claude conversation roles or content")
+    claude_tools: list[ToolParam] = [
+        {
+            "name": tool["function"]["name"],
+            "description": tool["function"]["description"],
+            "input_schema": tool["function"]["parameters"],
+        }
+        for tool in tools
+    ]
+    response = get_claude_client().messages.create(
+        model=CLAUDE_MODEL,
+        system=api_messages[0]["content"],
+        messages=cast(list[MessageParam], api_messages[1:]),
+        max_tokens=max_tokens,
+        output_config={"effort": cast(ClaudeEffort, CLAUDE_EFFORT)},
+        tools=claude_tools,
+        tool_choice={"type": "auto", "disable_parallel_tool_use": True},
+    )
+
+    return parse_claude_response(response)
+
+
+def parse_claude_response(response: Message) -> dict[str, Any]:
+    """Validate a completed native response without exposing thinking blocks."""
+    # Never forward incomplete tool JSON when the output budget is exhausted.
+    if response.stop_reason == "tool_use":
+        calls = [block for block in response.content if block.type == "tool_use"]
+        if (
+            len(calls) != 1 or calls[0].name != "search_with_grok"
+            or not isinstance(calls[0].id, str) or not calls[0].id.strip()
+        ):
+            raise ValueError("Unexpected Claude tool call")
+        arguments = calls[0].input
+        if not isinstance(arguments, dict):
+            raise ValueError("Invalid Claude tool arguments")
+        query = arguments.get("query")
+        prompt = arguments.get("prompt", "")
+        if not isinstance(query, str) or not query.strip() or not isinstance(prompt, str):
+            raise ValueError("Invalid Claude search arguments")
+        # These are routing notes, not search queries. Do not send a model's
+        # placeholder instruction to xAI; preserve the existing failure path.
+        sentinels = {"ask location", "no search needed", "ask location / no search needed"}
+        if any(" ".join(value.casefold().replace("_", " ").split()) in sentinels for value in (query, prompt)):
+            raise ValueError("Claude search contains a routing placeholder")
+        return {
+            "hasToolCall": True,
+            "toolName": "search_with_grok",
+            "toolQuery": query,
+            "toolPrompt": prompt,
+        }
+
+    if response.stop_reason != "end_turn":
+        raise ValueError("Claude response did not complete")
+    if any(block.type == "tool_use" for block in response.content):
+        raise ValueError("Claude tool call has an inconsistent stop reason")
+    text = "".join(block.text for block in response.content if block.type == "text")
+    if not text.strip():
+        raise ValueError("Claude response contains no text")
+    plain, _ = render_to_line(text)
+    if not plain.strip():
+        raise ValueError("Claude response contains no visible text")
+    return {"hasToolCall": False, "aiResponse": plain}
