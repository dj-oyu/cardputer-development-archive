+        trap 'rm -f "$secret_file"' EXIT
+        if aws secretsmanager describe-secret --secret-id ANTHROPIC_API_KEY >/dev/null 2>&1; then
+          if [ -n "${ANTHROPIC_API_KEY:-}" ]; then
+            printf '%s' "$ANTHROPIC_API_KEY" > "$secret_file"
+            aws secretsmanager update-secret --secret-id ANTHROPIC_API_KEY --secret-string "file://$secret_file" >/dev/null
+          else
+            echo 'Claude GitHub Secret absent: preserving existing AWS Secret.'
+          fi
+        else
+          printf '%s' "${ANTHROPIC_API_KEY:-PLACEHOLDER_NOT_A_VALID_ANTHROPIC_API_KEY_REPLACE_IN_GITHUB_ENV_ENV}" > "$secret_file"
