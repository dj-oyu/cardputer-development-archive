+    - name: Update or Create Claude Secret
+      env:
+        ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
+      run: |
+        # Pass via a private file, keeping the value out of shell interpolation,
+        # command arguments, logs and AWS CLI response output. Missing GitHub
+        # values preserve an existing AWS secret; only a new secret gets a dummy.
+        set -euo pipefail
+        umask 077
