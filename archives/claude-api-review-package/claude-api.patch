diff --git a/cdk/test/claude-provider.test.ts b/cdk/test/claude-provider.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c26b7872a56afebeae5b3f40c962db0fb81c4e15
--- /dev/null
+++ b/cdk/test/claude-provider.test.ts
@@ -0,0 +1,77 @@
+import * as cdk from 'aws-cdk-lib';
+import { Template, Match } from 'aws-cdk-lib/assertions';
+import { LineEchoStack } from '../lib/lambda-stack';
+
+describe('Claude provider configuration', () => {
+  const keys = ['AI_BACKEND', 'CLAUDE_MODEL', 'CLAUDE_EFFORT', 'CLAUDE_MAX_TOKENS'] as const;
+  let originals: Map<string, string | undefined>;
+
+  beforeEach(() => {
+    originals = new Map(keys.map(key => [key, process.env[key]]));
+    keys.forEach(key => delete process.env[key]);
+  });
+
+  afterEach(() => {
+    originals.forEach((value, key) => {
+      if (value === undefined) delete process.env[key];
+      else process.env[key] = value;
+    });
+  });
+
+  const synthesize = (): Template => Template.fromStack(new LineEchoStack(new cdk.App(), 'ClaudeTest'));
+
+  test('keeps Groq as default and passes only the Claude secret name', () => {
+    const template = synthesize();
+    template.hasResourceProperties('AWS::Lambda::Function', {
+      Handler: 'ai_processor.lambda_handler',
+      Environment: { Variables: Match.objectLike({
+        AI_BACKEND: 'groq',
+        ANTHROPIC_API_KEY_NAME: 'ANTHROPIC_API_KEY',
+        CLAUDE_MODEL: 'claude-haiku-5-5',
+        CLAUDE_EFFORT: 'low',
+        CLAUDE_MAX_TOKENS: '2000',
+      }) },
+    });
+    template.resourceCountIs('AWS::SecretsManager::Secret', 0);
+    template.resourceCountIs('AWS::Lambda::Function', 4);
+    template.resourceCountIs('AWS::StepFunctions::StateMachine', 1);
+  });
+
+  test('forwards explicit Claude selection and model configuration', () => {
+    process.env.AI_BACKEND = 'claude';
+    process.env.CLAUDE_MODEL = 'claude-sonnet-5-5';
+    process.env.CLAUDE_EFFORT = 'medium';
+    process.env.CLAUDE_MAX_TOKENS = '4000';
+    synthesize().hasResourceProperties('AWS::Lambda::Function', {
+      Handler: 'ai_processor.lambda_handler',
+      Environment: { Variables: Match.objectLike({
