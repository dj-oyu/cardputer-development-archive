index 0000000000000000000000000000000000000000..a2991c1c4c56f00e0c62317b247e8e59dbf6c573
--- /dev/null
+++ b/scripts/tests/test_claude_live_pilot.py
@@ -0,0 +1,163 @@
+"""Real SDK mocked transport and in-memory files; never use credentials/network."""
+
+import json
+import os
+import sys
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+import anthropic
+import httpx2
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT / "scripts"))
+sys.path.insert(0, str(ROOT / "lambda"))
+import claude_live_pilot as pilot  # noqa: E402
+from claude_provider import parse_claude_response  # noqa: E402
+
+
+class MemoryOutput:
+    def __init__(self):
+        self.text = ""
+
+    def mkdir(self, **kwargs):
+        pass
+
+    def __truediv__(self, name):
+        if name != "results.json":
+            raise AssertionError("Unexpected file")
+        return self
+
+    def write_text(self, text, **kwargs):
+        self.text = text
+
+
+class TestClaudeLivePilot(unittest.TestCase):
+    def setUp(self):
+        self.plan = pilot.make_plan(ROOT / "lambda" / "ai_processor.py")
+        self.requests = []
+        self.status = 200
+        self.creation_status = 200
+        self.count = 1000
+        self.force_tool = False
+        self.visible_text = "こんにちは"
+        self.output = MemoryOutput()
+        self.client = anthropic.Anthropic(
+            api_key="SYNTHETIC_OFFLINE_CREDENTIAL", max_retries=0,
+            http_client=anthropic.DefaultHttpxClient(transport=httpx2.MockTransport(self.handle)),
+        )
+        self.addCleanup(self.client.close)
+
+    def handle(self, request):
+        data = json.loads(request.content)
+        self.requests.append((request.url.path, data))
+        if self.status != 200:
+            return httpx2.Response(self.status, json={"type": "error", "error": {
+                "type": "authentication_error", "message": "SYNTHETIC_OFFLINE_CREDENTIAL",
+            }})
+        if request.url.path.endswith("count_tokens"):
+            return httpx2.Response(200, json={"input_tokens": self.count})
+        if self.creation_status != 200:
+            return httpx2.Response(self.creation_status, json={"type": "error", "error": {
+                "type": "invalid_request_error", "message": "SYNTHETIC_OFFLINE_CREDENTIAL",
+            }})
+        item = self.plan[sum(path == "/v1/messages" for path, _ in self.requests) - 1]
+        content = [{"type": "thinking", "thinking": "PRIVATE_THOUGHT", "signature": "PRIVATE_SIGNATURE"}]
+        if item["expected_search"] or self.force_tool:
+            content.append({"type": "tool_use", "name": "search_with_grok", "id": "toolu_test",
+                            "input": {"query": "京都駅周辺 今夜 営業", "prompt": "候補を教えて"}})
+        else:
+            content.append({"type": "text", "text": self.visible_text})
+        return httpx2.Response(200, json={
+            "id": "msg_synthetic", "type": "message", "role": "assistant", "model": pilot.MODEL,
+            "content": content, "stop_reason": "tool_use" if item["expected_search"] or self.force_tool else "end_turn",
+            "stop_sequence": None, "usage": {"input_tokens": 1000, "output_tokens": 100},
+        })
+
+    def run_pilot(self):
+        return pilot.run(self.plan, self.client, self.output, "SYNTHETIC_OFFLINE_CREDENTIAL", parse_claude_response)
+
+    def test_plan_balances_original_ab_and_history_with_bounded_cost(self):
+        self.assertEqual(len(self.plan), 10)
+        self.assertLess(pilot.MAX_CALLS * pilot.RESERVE_PER_CALL, 0.10)
+        for index in range(0, 10, 2):
+            a, b = self.plan[index:index + 2]
+            self.assertEqual((a["variant"], b["variant"]), ("A", "B"))
+            self.assertEqual(a["request"]["messages"], b["request"]["messages"])
+            self.assertEqual(a["request"]["tools"], b["request"]["tools"])
+            self.assertEqual(a["request"]["max_tokens"], 2000)
+        self.assertEqual(self.plan[6]["request"]["messages"][-1]["role"], "user")
+        self.assertEqual(len(self.plan[6]["request"]["messages"]), 3)
+
+    def test_complete_real_sdk_mock_excludes_secret_and_thinking(self):
+        self.assertEqual(self.run_pilot(), 0)
+        result = json.loads(self.output.text)
+        self.assertEqual(result["model_calls_started"], 10)
+        self.assertEqual(result["count_token_calls"], 10)
+        self.assertEqual(len(self.requests), 20)
+        self.assertFalse(result["search_executed"])
+        self.assertFalse(result["line_sent"])
+        self.assertNotIn("PRIVATE_", self.output.text)
+        self.assertNotIn("SYNTHETIC_OFFLINE_CREDENTIAL", self.output.text)
+        self.assertTrue(all(r["contract_valid"] for r in result["records"]))
+
+    def test_http_error_stops_at_first_request_with_no_body_export_or_retry(self):
+        for status in (400, 401, 404, 429, 500, 529):
+            with self.subTest(status=status):
+                self.requests.clear()
+                self.status = status
+                self.assertEqual(self.run_pilot(), 1)
+                self.assertEqual(len(self.requests), 1)
+                self.assertNotIn("SYNTHETIC_OFFLINE_CREDENTIAL", self.output.text)
+                self.assertEqual(json.loads(self.output.text)["model_calls_started"], 0)
+
+    def test_count_guard_prevents_any_paid_call(self):
+        self.count = pilot.MAX_COUNTED_INPUT + 1
+        self.assertEqual(self.run_pilot(), 1)
+        self.assertEqual(len(self.requests), 1)
+        self.assertEqual(json.loads(self.output.text)["model_calls_started"], 0)
+
+    def test_paid_api_error_stops_after_one_attempt_without_retry(self):
+        for status in (400, 401, 429, 500):
+            with self.subTest(status=status):
+                self.requests.clear()
+                self.creation_status = status
+                self.assertEqual(self.run_pilot(), 1)
+                self.assertEqual(len(self.requests), 2)
+                self.assertEqual(json.loads(self.output.text)["model_calls_started"], 1)
+                self.assertNotIn("SYNTHETIC_OFFLINE_CREDENTIAL", self.output.text)
+
+    def test_smoke_unexpected_tool_stops_after_one_paid_call(self):
+        self.force_tool = True
+        self.assertEqual(self.run_pilot(), 1)
+        result = json.loads(self.output.text)
+        self.assertEqual(result["status"], "smoke_failed_stopped_no_retry")
+        self.assertEqual(result["model_calls_started"], 1)
+        self.assertEqual(len(self.requests), 2)
+
+    def test_secret_returned_as_visible_output_is_never_saved(self):
+        self.visible_text = "SYNTHETIC_OFFLINE_CREDENTIAL"
+        self.assertEqual(self.run_pilot(), 1)
+        self.assertNotIn(self.visible_text, self.output.text)
+        self.assertEqual(len(self.requests), 2)
+
+    def test_dispatch_and_feature_branch_required_no_rerun(self):
+        environment = {"GITHUB_ACTIONS": "true", "GITHUB_EVENT_NAME": "workflow_dispatch",
+                       "GITHUB_RUN_ATTEMPT": "1", "GITHUB_REPOSITORY": "dj-oyu/echo-line-bot",
+                       "GITHUB_REF": "refs/heads/feature/claude-api"}
+        with patch.dict(os.environ, environment):
+            self.assertTrue(pilot.execution_allowed())
+            for key, value in (("GITHUB_REF", "refs/heads/main"), ("GITHUB_RUN_ATTEMPT", "2"),
+                               ("GITHUB_EVENT_NAME", "push")):
+                with patch.dict(os.environ, {key: value}):
+                    self.assertFalse(pilot.execution_allowed())
+
+    def test_main_offline_preparation_never_constructs_client(self):
+        with patch.object(sys, "argv", ["claude_live_pilot.py"]), patch.object(anthropic, "Anthropic") as client:
+            self.assertEqual(pilot.main(), 0)
+            client.assert_not_called()
+
+
+if __name__ == "__main__":
+    unittest.main()
