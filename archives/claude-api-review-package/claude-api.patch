+def response_body(content, stop_reason="end_turn"):
+    return {
+        "id": "msg_offline",
+        "type": "message",
+        "role": "assistant",
+        "model": "claude-haiku-5-5",
+        "content": content,
+        "stop_reason": stop_reason,
+        "stop_sequence": None,
+        "usage": {"input_tokens": 100, "output_tokens": 20},
+    }
+
+
+def search_block(**arguments):
+    return {"type": "tool_use", "id": "toolu_offline", "name": "search_with_grok", "input": arguments}
+
+
+class TestClaudeTransport(unittest.TestCase):
+    def setUp(self):
+        self.requests = []
+        self.body = response_body([{"type": "text", "text": "**まいど！**"}])
+        self.status = 200
+        self.transport_error = None
+        self.client = anthropic.Anthropic(
+            api_key="SYNTHETIC_OFFLINE_CREDENTIAL",
+            base_url="https://api.anthropic.com",
+            max_retries=0,
+            timeout=30,
+            http_client=anthropic.DefaultHttpxClient(
+                transport=httpx2.MockTransport(self.handle), follow_redirects=False
+            ),
+        )
+        self.addCleanup(self.client.close)
+        self.patch_value(ai_processor, "AI_SELECT", "claude")
+        self.patch_value(claude_provider, "_client", self.client)
+        self.patch_value(claude_provider, "CLAUDE_MODEL", "claude-haiku-5-5")
+        self.patch_value(claude_provider, "CLAUDE_EFFORT", "low")
+        self.patch_value(claude_provider, "CLAUDE_MAX_TOKENS", "2000")
+        self.messages = [
+            {"role": "user", "content": "前の質問"},
+            {"role": "assistant", "content": "前の回答"},
+            {"role": "user", "content": "@bot やあ"},
+        ]
+
+    def patch_value(self, target, name, value):
+        patcher = patch.object(target, name, value)
+        patcher.start()
+        self.addCleanup(patcher.stop)
+
+    def handle(self, request):
+        # Retain only the JSON body and URL, never auth headers.
+        self.requests.append((str(request.url), json.loads(request.content)))
+        if self.transport_error:
+            raise self.transport_error
+        return httpx2.Response(self.status, json=self.body)
+
+    def ask(self):
+        return ai_processor.get_ai_response(self.messages)
+
+    def test_one_direct_request_preserves_prompt_and_full_history(self):
+        original = copy.deepcopy(self.messages)
