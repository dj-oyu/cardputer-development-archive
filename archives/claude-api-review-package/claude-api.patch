@@ -0,0 +1,35 @@
+"""Review-plan tests are offline; no production modules or credentials."""
+
+import sys
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT / "scripts"))
+import claude_tool_plan  # noqa: E402 - load the script directory without application imports
+import dialect_ab  # noqa: E402
+
+
+class TestClaudeToolPlan(unittest.TestCase):
+    def test_cases_cover_greeting_location_and_current_information(self):
+        plan = claude_tool_plan.make_plan(ROOT / "lambda" / "ai_processor.py")
+        self.assertEqual(plan["status"], "prepared_no_requests")
+        self.assertEqual(len(plan["schedule"]), 8)
+        self.assertEqual({case["case"] for case in plan["schedule"]}, {
+            "greeting", "missing_location", "explicit_location", "current_information",
+        })
+        self.assertEqual(plan["source_sha256"], dialect_ab.SOURCE_SHA256)
+        self.assertEqual(len(plan["invalid_tool_inputs"]), 6)
+
+    def test_same_prompts_and_tools_are_used_with_claude_native_parameters(self):
+        prompt, tools = dialect_ab.extract_source(ROOT / "lambda" / "ai_processor.py")
+        plan = claude_tool_plan.make_plan(ROOT / "lambda" / "ai_processor.py")
+        for case in plan["schedule"]:
+            request = case["request"]
+            expected = prompt if case["variant"] == "A" else dialect_ab.without_dialect(prompt)
+            self.assertEqual(request["system"], expected)
+            self.assertEqual(request["model"], "claude-haiku-5-5")
+            self.assertEqual(request["tools"][0]["input_schema"], tools[0]["function"]["parameters"])
+            self.assertNotIn("temperature", request)
+            self.assertNotIn("reasoning_effort", request)
+            self.assertEqual(request["tool_choice"], {"type": "auto", "disable_parallel_tool_use": True})
