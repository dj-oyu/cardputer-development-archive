+            "ai_processor.get_current_date_info",
+            return_value={"date": "固定の日付", "weekday": "木", "time": "固定の時刻", "season": "秋"},
+        ):
+            expected = ai_processor.prepare_messages_for_api(self.messages)
+            result = self.ask()
+        self.assertEqual(result, {"hasToolCall": False, "aiResponse": "まいど！"})
+        self.assertEqual(len(self.requests), 1)
+        url, body = self.requests[0]
+        self.assertEqual(url, "https://api.anthropic.com/v1/messages")
+        self.assertEqual(body["system"], expected[0]["content"])
+        self.assertEqual(body["messages"], expected[1:])
+        self.assertEqual(self.messages, original)
+        self.assertEqual(body["model"], "claude-haiku-5-5")
+        self.assertEqual(body["max_tokens"], 2000)
+        self.assertEqual(body["output_config"], {"effort": "low"})
