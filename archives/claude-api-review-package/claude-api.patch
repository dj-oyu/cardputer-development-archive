index 0000000000000000000000000000000000000000..4a39284c93023051073714c672f3974ae79d113f
--- /dev/null
+++ b/scripts/tests/test_claude_secret_sync.py
@@ -0,0 +1,48 @@
+"""Exercise the exact deployment shell step with fake AWS, on supported POSIX."""
+
+import os
+import subprocess
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+@unittest.skipUnless(os.name == "posix", "Deployment step requires the normal Linux shell")
+class TestClaudeSecretSync(unittest.TestCase):
+    def test_missing_and_present_values_preserve_existing_secret(self):
+        source = (ROOT / ".github" / "workflows" / "deploy.yml").read_text(encoding="utf-8")
+        step = source.split("    - name: Update or Create Claude Secret\n", 1)[1]
+        step = step.split("      run: |\n", 1)[1].split("    - name: Deploy to AWS", 1)[0]
+        code = "\n".join(line[8:] for line in step.splitlines() if line.startswith("        "))
+        for exists, value, expected in (
+            (True, "", ""), (False, "", "create-secret"),
+            (True, "SYNTHETIC_TEST_VALUE", "update-secret"),
+            (False, "SYNTHETIC_TEST_VALUE", "create-secret"),
+        ):
+            with self.subTest(exists=exists, has_value=bool(value)):
+                fake = '''aws() {
+                  [ "$1" = secretsmanager ] || return 99
+                  if [ "$2" = describe-secret ]; then return "$EXISTS_STATUS"; fi
+                  case "$2" in
+                    update-secret|create-secret)
+                      [ "$5" = --secret-string ] || return 98
+                      payload_file="${6#file://}"
+                      [ "$(cat "$payload_file")" = "$EXPECTED_PAYLOAD" ] || return 97
+                      echo "$2" >&2;;
+                    *) return 96;;
+                  esac
+                }
+                '''
+                environment = {**os.environ, "ANTHROPIC_API_KEY": value,
+                               "EXISTS_STATUS": "0" if exists else "1",
+                               "EXPECTED_PAYLOAD": value or "PLACEHOLDER_NOT_A_VALID_ANTHROPIC_API_KEY_REPLACE_IN_GITHUB_ENV_ENV"}
+                result = subprocess.run(["bash", "-s"], input=fake + code, env=environment,
+                                        capture_output=True, text=True, timeout=10)
+                self.assertEqual(result.returncode, 0, result.stderr)
+                self.assertEqual(result.stderr.strip(), expected)
+                self.assertNotIn("SYNTHETIC_TEST_VALUE", result.stdout + result.stderr)
+
+
+if __name__ == "__main__":
+    unittest.main()
