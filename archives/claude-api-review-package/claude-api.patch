@@ -0,0 +1,83 @@
+"""Prepare a Claude routing A/B review plan without importing handlers or APIs."""
+
+import argparse
+import json
+from pathlib import Path
+
+import dialect_ab
+
+CASES = (
+    {
+        "id": "greeting",
+        "input": "やっほい",
+        "review": "Direct greeting; no search_with_grok call.",
+    },
+    {
+        "id": "missing_location",
+        "input": "おすすめの飲食店ある?",
+        "review": "Ask the user's location; do not infer Osaka from the character's dialect.",
+    },
+    {
+        "id": "explicit_location",
+        "input": "梅田で今夜営業している飲食店を調べて",
+        "review": "One search_with_grok call with a nonblank query grounded in Umeda and tonight.",
+    },
+    {
+        "id": "current_information",
+        "input": "今日の東京の天気を調べて",
+        "review": "One search_with_grok call grounded in Tokyo and today's weather.",
+    },
+)
+
+
+def make_plan(source: Path) -> dict:
+    """Reuse the pinned A/B prompts and schema; prepare requests, never send them."""
+    prompt, tools = dialect_ab.extract_source(source)
+    prompts = {"A": prompt, "B": dialect_ab.without_dialect(prompt)}
+    claude_tools = [
+        {
+            "name": tool["function"]["name"],
+            "description": tool["function"]["description"],
+            "input_schema": tool["function"]["parameters"],
+        }
+        for tool in tools
+    ]
+    schedule = []
+    for case in CASES:
+        for variant, system in prompts.items():
+            schedule.append({
+                "case": case["id"], "variant": variant, "review": case["review"],
+                "request": {
+                    "model": "claude-haiku-5-5", "max_tokens": 2000,
+                    "output_config": {"effort": "low"}, "system": system,
+                    "messages": [{"role": "user", "content": case["input"]}],
+                    "tools": claude_tools,
+                    "tool_choice": {"type": "auto", "disable_parallel_tool_use": True},
+                },
+            })
+    return {
+        "status": "prepared_no_requests", "provider": "claude",
+        "source_commit": dialect_ab.SOURCE_COMMIT, "source_sha256": dialect_ab.SOURCE_SHA256,
+        "schedule": schedule,
+        "invalid_tool_inputs": [
+            {"query": ""}, {"query": "Ask location"}, {"query": "No search needed"},
+            {"query": "Ask location / No search needed"}, {"query": 42},
+            {"query": "東京 天気", "prompt": None},
+        ],
+        "live_review": "Model routing and location assumptions require separate approval for paid API testing.",
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    source = Path(__file__).resolve().parents[1] / "lambda" / "ai_processor.py"
+    plan = make_plan(source)
+    args.output.write_text(json.dumps(plan, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
+    print("Prepared 8 Claude routing requests; no network calls made")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
