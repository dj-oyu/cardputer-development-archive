+
+    def test_malformed_or_unknown_search_uses_existing_failure_response(self):
+        invalid_blocks = [
+            search_block(), search_block(query=""), search_block(query=42),
+            search_block(query="x", prompt=None),
+            search_block(query="Ask location"), search_block(query="No search needed"),
