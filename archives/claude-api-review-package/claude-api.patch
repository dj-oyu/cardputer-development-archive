new file mode 100644
index 0000000000000000000000000000000000000000..92eb454eb77089fe31dae0771dd803514a2ae985
--- /dev/null
+++ b/scripts/claude_live_pilot.py
@@ -0,0 +1,208 @@
+"""Manual-only bounded synthetic Claude A/B pilot; never invoke LINE or xAI."""
+
+import argparse
+import json
+import os
+import re
+import sys
+import time
+from pathlib import Path
+
+import anthropic
+import dialect_ab
+
+MODEL = "claude-haiku-5-5"
+MAX_CALLS = 10
+MAX_REQUEST_BYTES = 8192
+MAX_COUNTED_INPUT = 4096
+MAX_BILLED_INPUT = 8192  # 2x token-count estimate headroom, far below 100k.
+MAX_OUTPUT = 2000  # Includes native thinking.
+BUDGET_USD = 0.10
+INPUT_RATE = 0.10 / 1_000_000
+OUTPUT_RATE = 0.50 / 1_000_000
+# Reserve the more expensive >100k rates despite enforcing much smaller input.
+RESERVE_PER_CALL = MAX_BILLED_INPUT * 0.50 / 1_000_000 + MAX_OUTPUT * 2.50 / 1_000_000
+CASES = (
+    ("greeting", [{"role": "user", "content": dialect_ab.INPUTS[0]}], False),
+    ("missing_location", [{"role": "user", "content": dialect_ab.INPUTS[1]}], False),
+    ("explicit_location", [{"role": "user", "content": "梅田で今夜営業している飲食店を調べて"}], True),
+    ("corrected_location", [
+        {"role": "user", "content": "梅田でご飯を食べたい"},
+        {"role": "assistant", "content": "どんなお店がええ？"},
+        {"role": "user", "content": "場所を訂正、梅田じゃなく京都駅周辺で今夜営業中の飲食店を調べて"},
+    ], True),
+    ("simple_chat", [{"role": "user", "content": "今日は仕事が終わってほっとしたよ"}], False),
+)
+
+
+def make_plan(source: Path) -> list[dict]:
+    prompt, tools = dialect_ab.extract_source(source)
+    native_tools = [{"name": t["function"]["name"], "description": t["function"]["description"],
+                     "input_schema": t["function"]["parameters"]} for t in tools]
+    plan = []
+    for case, messages, expected_search in CASES:
+        for variant, system in (("A", prompt), ("B", dialect_ab.without_dialect(prompt))):
+            request = {
+                "model": MODEL, "max_tokens": MAX_OUTPUT, "system": system,
+                "messages": messages, "tools": native_tools,
+                "output_config": {"effort": "low"},
+                "tool_choice": {"type": "auto", "disable_parallel_tool_use": True},
+            }
+            if len(json.dumps(request, ensure_ascii=False).encode()) > MAX_REQUEST_BYTES:
+                raise ValueError("Synthetic request exceeds size bound")
+            plan.append({"case": case, "variant": variant, "expected_search": expected_search,
+                         "request": request})
+    if len(plan) != MAX_CALLS or MAX_CALLS * RESERVE_PER_CALL > BUDGET_USD:
+        raise ValueError("Pilot exceeds total budget")
+    return plan
+
+
+def safe_error(exc: Exception) -> dict:
+    """Allowlist status/type only; never serialize an exception or error body."""
+    category = "invalid_response_or_guard"
+    if isinstance(exc, anthropic.APIStatusError):
+        status = exc.status_code
+        category = {401: "authentication_failed", 403: "permission_or_billing_denied",
+                    404: "model_or_endpoint_not_available", 429: "quota_or_rate_limit",
+                    500: "provider_error", 529: "provider_overloaded"}.get(status, "api_rejected")
+        body = exc.body if isinstance(exc.body, dict) else {}
+        error = body.get("error", body)
+        error = error if isinstance(error, dict) else {}
+        # Inspect only in memory to distinguish a common paid-account blocker.
+        if any(term in str(error.get("message", "")).lower()
+               for term in ("credit balance", "insufficient credit", "billing", "quota")):
+            category = "billing_or_quota_unavailable"
+        kind = error.get("type")
+        result = {"category": category, "http_status": status}
+        if isinstance(kind, str) and re.fullmatch(r"[a-z_]{1,64}", kind):
+            result["api_error_type"] = kind
+        return result
+    if isinstance(exc, anthropic.APITimeoutError):
+        category = "timeout_no_retry"
+    elif isinstance(exc, anthropic.APIConnectionError):
+        category = "connection_failed_no_retry"
+    return {"category": category}
+
+
+def measure_response(response, item: dict, parse_response) -> dict:
+    """Retain visible synthetic output and measurements, exclude all thinking."""
+    usage = response.usage
+    input_tokens, output_tokens = usage.input_tokens, usage.output_tokens
+    if (type(input_tokens) is not int or type(output_tokens) is not int
+            or not 0 <= input_tokens <= MAX_BILLED_INPUT or not 0 <= output_tokens <= MAX_OUTPUT
+            or response.model != MODEL
+            or (usage.cache_creation_input_tokens or 0) != 0
+            or (usage.cache_read_input_tokens or 0) != 0):
+        raise ValueError("Unexpected model or token accounting")
+    record = {
+        "stop_reason": response.stop_reason,
+        "input_tokens": input_tokens, "output_tokens": output_tokens,
+        "thinking_present": any(b.type in ("thinking", "redacted_thinking") for b in response.content),
+        "estimated_usd": round(input_tokens * INPUT_RATE + output_tokens * OUTPUT_RATE, 9),
+    }
+    try:
+        parsed = parse_response(response)
+    except ValueError:
+        record["contract_valid"] = False
+        return record
+    record["contract_valid"] = True
+    record["result"] = parsed
+    record["expected_search_matched"] = parsed["hasToolCall"] == item["expected_search"]
+    return record
+
+
+def run(plan: list[dict], client, output: Path, key: str, parse_response) -> int:
+    records = []
+    report = {
+        "status": "running", "model": MODEL, "effort": "low", "max_tokens": MAX_OUTPUT,
+        "max_calls": MAX_CALLS, "budget_usd": BUDGET_USD,
+        "maximum_reserved_usd": round(MAX_CALLS * RESERVE_PER_CALL, 6),
+        "source_commit": dialect_ab.SOURCE_COMMIT, "source_sha256": dialect_ab.SOURCE_SHA256,
+        "count_token_calls": 0, "model_calls_started": 0, "records": records,
+        "search_executed": False, "line_sent": False, "sdk_retries": 0,
+    }
+    output.mkdir(parents=True, exist_ok=True)
+    for index, item in enumerate(plan):
+        if index >= MAX_CALLS or (index + 1) * RESERVE_PER_CALL > BUDGET_USD:
+            report["status"] = "budget_guard_stopped"
+            break
+        record = {"index": index, "case": item["case"], "variant": item["variant"]}
+        records.append(record)
+        started = time.monotonic()
+        try:
+            request = item["request"]
+            counted = client.messages.count_tokens(**{k: request[k] for k in
+                ("model", "system", "messages", "tools", "tool_choice")})
+            report["count_token_calls"] += 1
+            if type(counted.input_tokens) is not int or not 0 <= counted.input_tokens <= MAX_COUNTED_INPUT:
+                raise ValueError("Input exceeds token guard")
+            record["counted_input_tokens"] = counted.input_tokens
+            report["model_calls_started"] += 1  # Reserve before the network request, even on error.
+            before = time.monotonic()
+            response = client.messages.create(**request)
+            record["api_latency_seconds"] = round(time.monotonic() - before, 4)
+            record.update(measure_response(response, item, parse_response))
+            if key in json.dumps(record, ensure_ascii=False):
+                record.clear()
+                record.update({"index": index, "case": item["case"], "variant": item["variant"]})
+                raise ValueError("Sensitive output rejected")
+            if not record["contract_valid"]:
+                report["status"] = "invalid_contract_stopped_no_retry"
+            # First original-prompt greeting is the sole authentication/model smoke call.
+            # Only a complete visible greeting without a tool continues to the remaining cases.
+            if index == 0 and not record.get("expected_search_matched", False):
+                report["status"] = "smoke_failed_stopped_no_retry"
+        except Exception as exc:
+            record["error"] = safe_error(exc)
+            report["status"] = "api_or_guard_error_stopped_no_retry"
+        record["total_latency_seconds"] = round(time.monotonic() - started, 4)
+        report["estimated_total_usd"] = round(sum(r.get("estimated_usd", 0) for r in records), 9)
+        serialized = json.dumps(report, ensure_ascii=False, indent=2) + "\n"
+        if key in serialized:
+            raise ValueError("Sensitive report rejected")
+        (output / "results.json").write_text(serialized, encoding="utf-8")
+        print(f"case {index + 1}/{MAX_CALLS}: {item['case']} {item['variant']}; {report['status']}")
+        if report["status"] != "running":
+            return 1
+    report["status"] = "complete" if len(records) == MAX_CALLS else report["status"]
+    (output / "results.json").write_text(json.dumps(report, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
+    return 0 if report["status"] == "complete" else 1
+
+
+def execution_allowed() -> bool:
+    return (dialect_ab.live_execution_allowed()
+            and os.environ.get("GITHUB_REF") == "refs/heads/feature/claude-api")
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--execute", action="store_true")
+    args = parser.parse_args()
+    source = Path(__file__).resolve().parents[1] / "lambda" / "ai_processor.py"
+    plan = make_plan(source)
+    if not args.execute:
+        print(f"Prepared {len(plan)} synthetic calls; reserved upper bound ${MAX_CALLS * RESERVE_PER_CALL:.6f}; no API calls")
+        return 0
+    if not execution_allowed():
+        print("Execution requires first-attempt manual Actions dispatch on reviewed feature branch")
+        return 1
+    key = os.environ.pop("ANTHROPIC_API_KEY", "").strip()
+    if not key or any(marker in key.lower() for marker in ("placeholder", "dummy", "replace", "xxxx")):
+        print("Anthropic Environment Secret is absent or a placeholder; no request made")
+        return 1
+    # Only import the pure response parser; no production handler, AWS client,
+    # LINE sender or Grok processor is invoked, and the key stays in memory.
+    sys.path.insert(0, str(source.parent))
+    from claude_provider import parse_claude_response
+    with anthropic.Anthropic(api_key=key, base_url="https://api.anthropic.com", timeout=30,
+                             max_retries=0, http_client=anthropic.DefaultHttpxClient(
+                                 follow_redirects=False, trust_env=False)) as client:
+        return run(plan, client, Path("claude-pilot-results"), key, parse_claude_response)
+
+
+if __name__ == "__main__":
+    try:
+        raise SystemExit(main())
+    except Exception as failure:
+        print(json.dumps({"pilot_stopped": True, **safe_error(failure)}))
+        raise SystemExit(1) from None
