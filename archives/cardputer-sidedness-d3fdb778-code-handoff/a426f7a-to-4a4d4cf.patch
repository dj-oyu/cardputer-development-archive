+ for(unsigned j=0;j<32;j++){vertices[j]=(co_vertex){(float)j,(float)(j%5),(float)j-2,(float)j/7,(uint16_t)(j*23),(uint16_t)(j*79)};back[2*j]=(uint16_t)(65535-j);back[2*j+1]=(uint16_t)(32000-j);}
