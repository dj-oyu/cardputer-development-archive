+ const vertices=nv===3?[10,10,0,30,10,0,10,30,0]:Array.from({length:nv},(_,i)=>[20+10*Math.cos(i*2*Math.PI/nv),20+10*Math.sin(i*2*Math.PI/nv),0]).flat();
