  "excludeCategories": [
    "All GLB/model/media binaries",
    "All source NPZ/coordinate/normal/control-point arrays",
    "Raw source parameter files",
    "Source-correspondence-private maps",
    "plan-measurements.json",
    "nine-full-measurements.json",
