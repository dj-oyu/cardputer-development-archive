{
  "version": 1,
  "policy": "Explicit files only, never recursive/glob inclusion. Code and report artifacts only.",
  "include": [
    "REPORT.md",
    "PLAN.md",
    "CONTRACT.md",
    "build-report.json",
    "final-plan-summary.json",
    "preflight-topology.json",
    "build.py",
    "measure_plan.py",
    "measure_nine_light.py",
    "measure_nine_full.py",
    "preflight_topology.py",
    "independent-construction-review.json"
