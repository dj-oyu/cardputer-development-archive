{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fox-candidate:rgb565:v1",
  "title": "Frozen-v3 candidate input manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "candidate",
    "reference",
    "resolution",
    "rgb565Format",
    "depthFormat",
    "frames"
  ],
  "properties": {
    "schemaVersion": {
      "const": "fox-candidate-rgb565-v1"
    },
    "candidate": {
      "type": "object",
      "required": [
        "label",
        "sourceLabel",
        "head",
        "sourceFiles"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "sourceLabel": {
          "type": "string",
          "minLength": 1
        },
        "head": {
          "type": "string",
          "minLength": 1
        },
        "sourceFiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/file"
          }
        }
      }
    },
    "reference": {
      "type": "object",
      "required": [
        "version",
        "configSHA256"
      ],
      "properties": {
        "version": {
          "const": "new-reference-uncertainty-v3"
        },
        "configSHA256": {
          "const": "4a9d836a4dae2fc570f5f0fb99690ab0f13fbe394589f785b56e891e0573dc40"
        }
      }
    },
    "resolution": {
      "const": [
        240,
        135
      ]
    },
    "rgb565Format": {
      "const": "RGB565_U16_LE_ROW_MAJOR"
    },
    "depthFormat": {
      "const": "FLOAT32_LE_ROW_MAJOR_NEG_INF_BACKGROUND"
    },
    "frames": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "view",
          "case",
          "rgb565",
          "depth",
          "metadata"
        ],
        "properties": {
          "view": {
            "enum": [
              "front",
              "oblique"
            ]
          },
          "case": {
            "enum": [
              "baseline",
              "direction",
              "intensity",
              "ambient",
              "albedo"
            ]
          },
          "rgb565": {
            "$ref": "#/$defs/file"
          },
          "depth": {
            "$ref": "#/$defs/file"
          },
          "metadata": {
            "type": "object",
            "required": [
              "resolution",
              "nativeCamera",
              "scenario",
              "sourceLabel",
              "head",
              "actual",
              "nativeInput"
            ],
            "properties": {
              "resolution": {
                "const": [
                  240,
                  135
                ]
              },
              "nativeCamera": {
                "type": "array",
                "minItems": 9,
                "maxItems": 9,
                "items": {
                  "type": "number"
                }
              },
              "scenario": {
                "type": "object"
              },
              "sourceLabel": {
                "type": "string",
                "minLength": 1
              },
              "head": {
                "type": "string",
                "minLength": 1
              },
              "nativeInput": {
                "type": "object",
                "description": "Exact scenario object from hashed inputs/candidate-config.json."
              },
              "actual": {
                "type": "object",
                "required": [
                  "camera",
                  "light"
                ],
                "properties": {
                  "camera": {
                    "type": "array",
                    "minItems": 9,
                    "maxItems": 9,
                    "items": {
                      "type": "number"
                    }
                  },
                  "light": {
                    "type": "array",
                    "minItems": 6,
                    "maxItems": 6,
                    "items": {
                      "type": "number"
                    }
                  },
                  "linearLightEnabled": {
                    "type": "boolean",
                    "description": "Required exactly when hashed candidate-config declares the same boolean mode."
                  },
                  "physicalDiskEnabled": {
                    "type": "boolean",
                    "description": "Required exactly when hashed candidate-config declares physical mode. Must equal its boolean value."
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "required": [
        "file",
        "sha256"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1,
          "description": "Normalized relative path within manifest directory; no absolute paths, parent traversal or reused paths."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
