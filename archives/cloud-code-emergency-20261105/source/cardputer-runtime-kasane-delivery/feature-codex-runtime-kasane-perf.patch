     check(ksn_runtime_shutdown()==KSN_OK&&live_allocations==0,"imucal test teardown frees memory");
-
     printf("%s\n",failures?"IMUCAL KASANE TEST FAIL":"IMUCAL KASANE TEST PASS");
     return failures?1:0;
 }
