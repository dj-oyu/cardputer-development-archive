-#ifdef POCKET_HEAPPROBE
-void app_heapprobe_release(void) { free(hp_copy); hp_copy=NULL; }
-
-bool app_heapprobe_select(const char *arg, const char **source, size_t *length,
-                          const char **app_id) {
-    app_heapprobe_release();
-    hp_chunk_set=-1;
-    hp_module=false;
-    char *end;
-    unsigned long index=strtoul(arg,&end,10);
-    size_t limit=*end==','?(size_t)strtoul(end+1,NULL,10):0;
-    // Walk the "//@ name" lines; a section runs to the next one.
-    // EMBED_TXTFILES appends a NUL, which is not source.
-    const char *p=heapprobe_start, *body=NULL, *next=NULL;
-    const char *stop=heapprobe_start+(size_t)(heapprobe_end-heapprobe_start-1);
-    unsigned seen=0;
-    while(p<stop) {
-        const char *eol=memchr(p,'\n',(size_t)(stop-p));
-        if(!eol) eol=stop;
-        if(eol-p>=3 && !memcmp(p,"//@",3)) {
-            if(body) { next=p; break; }
-            if(seen++==index) {
-                const char *n=p+3;
-                while(n<eol && *n==' ') n++;
-                snprintf(hp_name,sizeof hp_name,"%.*s",(int)(eol-n),n);
-                body=eol<stop?eol+1:eol;
-            }
-        }
-        p=eol+1;
-    }
-    if(!body) { ESP_LOGW("app","HEAPPROBE no variant %lu",index); return false; }
-    if(!next) next=stop;
-    *length=(size_t)(next-body); *app_id=APP_ID_DEFAULT;
-    if(*length>=6 && !memcmp(body,"@derby",6)) {
-        // The app's identity too: its manifest decides the capabilities the
-        // evaluation can reach and the store it would save to.
-        *app_id="local.derby";
-        // The entry of a chunked variant: it only loads the chunks, the way
-        // an app would with a synchronous load(name) (proposal B). It names
-        // kasane so the arena is taken before the evaluation, as for the app.
-        static const char entry3[]="// pocket.kasane\n__hpLoad(0);__hpLoad(1);__hpLoad(2);";
-        static const char entry4[]="// pocket.kasane\n__hpLoad(0);__hpLoad(1);__hpLoad(2);__hpLoad(3);";
-        const char *kind=body+6;
-        if(!strncmp(kind,"-spread",7)) {
-            *source=hp_spread_start; *length=(size_t)(hp_spread_end-hp_spread_start-1);
-        } else if(!strncmp(kind,"-flat",5)) {
-            *source=hp_flat_start; *length=(size_t)(hp_flat_end-hp_flat_start-1);
-        } else if(!strncmp(kind,"-split3",7)) {
-            hp_chunk_set=0; *source=entry3; *length=sizeof entry3-1;
-        } else if(!strncmp(kind,"-split4",7)) {
-            hp_chunk_set=1; *source=entry4; *length=sizeof entry4-1;
-        } else if(!strncmp(kind,"-load3",6)) {
-            // The same chunks through the product's loader: s3c1..s3c3 are
-            // local.derby's in this image (main/CMakeLists.txt's hp_chunks.txt).
-            // No binding of its own: the chunks' top-level names are global.
-            static const char entry[]="// pocket.kasane\npocket.app.load('s3c1');pocket.app.load('s3c2');pocket.app.load('s3c3');";
-            *source=entry; *length=sizeof entry-1;
-        } else if(!strncmp(kind,"-load4",6)) {
-            static const char entry[]="// pocket.kasane\npocket.app.load('s4c1');pocket.app.load('s4c2');pocket.app.load('s4c3');pocket.app.load('s4c4');";
-            *source=entry; *length=sizeof entry-1;
-        } else if(!strncmp(kind,"-bc",3)) {
-            static const char entry_bc[]="// pocket.kasane\n__hpLoadBC();";
-            *source=entry_bc; *length=sizeof entry_bc-1;
-        } else {
-            *source=hp_derby_start; *length=(size_t)(hp_derby_end-hp_derby_start-1);
-        }
-    } else if(*length>=5 && !memcmp(body,"@imp-",5)) {
-        // HELLO WORLD's identity, whose chunk set holds the parts.
-        const char *kind=body+5;
-        if(!strncmp(kind,"single",6)) {
-            *source=hp_imp_all_start; *length=(size_t)(hp_imp_all_end-hp_imp_all_start-1);
-        } else if(!strncmp(kind,"load3",5)) {
-            *source=hp_imp_load_start; *length=(size_t)(hp_imp_load_end-hp_imp_load_start-1);
-        } else {
-            *source=hp_imp_import_start; *length=(size_t)(hp_imp_import_end-hp_imp_import_start-1);
-            hp_module=true;
-        }
-    } else {
-        // "@chunks3" on a section's first line: __hpLoad(k) loads DERBY
-        // WATCH's 3-chunk set, from a frame() rather than at evaluation.
-        if(*length>=9 && !memcmp(body,"@chunks3\n",9)) {
-            hp_chunk_set=0; body+=9; *length-=9;
-        }
-        if(*length>=8 && !memcmp(body,"@module\n",8)) {
-            hp_module=true; body+=8; *length-=8;
-        }
-        // A copy, because JS_Eval reads up to a NUL at source[length] and a
-        // section in the middle of the file has the next one there instead.
-        hp_copy=malloc(*length+1);
-        if(!hp_copy) { ESP_LOGW("app","HEAPPROBE no copy"); return false; }
-        memcpy(hp_copy,body,*length);
-        hp_copy[*length]=0;
-        *source=hp_copy;
-    }
-    hp_index=(unsigned)index; hp_limit=limit; hp_active=true;
-    ESP_LOGI("app","HEAPPROBE select %u %s bytes=%u limit=%u",
-             hp_index,hp_name,(unsigned)*length,(unsigned)limit);
-    return true;
-}
-
-// Proposal B's spike: __hpLoad(k) evaluates chunk k of the selected set as a
-// global script in this realm and returns its completion value. Everything
-// the earlier chunks declared at top level is visible to it (the realm's
-// global lexical environment); its parse temporaries are gone when it returns.
-static JSValue hp_load(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv) {
-    int32_t k;
-    if(hp_chunk_set<0 || JS_ToInt32(ctx,&k,argv[0]) || k<0 || k>3 ||
-       !HP_CHUNKS[hp_chunk_set][k][0])
-        return JS_ThrowRangeError(ctx,"no chunk");
-    const char *s=HP_CHUNKS[hp_chunk_set][k][0];
-    size_t n=(size_t)(HP_CHUNKS[hp_chunk_set][k][1]-s-1);
-    size_t used0=0,limit=0,used1=0;
-    JSRuntime *rt=JS_GetRuntime(ctx);
-    JS_GetMemoryCounters(rt,&used0,&limit);
-    char name[16];
-    snprintf(name,sizeof name,"chunk%d.js",(int)k);
-    const int64_t t0=esp_timer_get_time();
-    JSValue r=JS_Eval(ctx,s,n,name,JS_EVAL_TYPE_GLOBAL);
-    const int64_t us=esp_timer_get_time()-t0;
-    JS_GetMemoryCounters(rt,&used1,&limit);
-    ESP_LOGI("app","HEAPPROBE chunk %d bytes=%u used %u -> %u us=%lld%s",(int)k,(unsigned)n,
-             (unsigned)used0,(unsigned)used1,(long long)us,JS_IsException(r)?" EXCEPTION":"");
-    return r;
-}
