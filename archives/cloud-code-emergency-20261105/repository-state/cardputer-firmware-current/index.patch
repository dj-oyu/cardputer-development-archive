-        return VIM_ACT_NONE;
-    }
-    if(c=='0') {
-        uint32_t *slot = v->op ? &v->count2 : &v->count1;
-        if(*slot) { if(*slot<100000u) *slot*=10; return VIM_ACT_NONE; }
-    }
-
-    if(c!='j' && c!='k' && k.kind!=VIM_KEY_UP && k.kind!=VIM_KEY_DOWN)
