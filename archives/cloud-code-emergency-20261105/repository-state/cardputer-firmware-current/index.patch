-    /* low_bits != 0 if there are a non zero low bit in abs(a) */
-    low_bits = 0;
-    carry = sgn;
-    for (i = 0; i < n1; i++) {
-        v = (a->tab[i] ^ (-sgn)) + carry;
-        carry = v < carry;
-        low_bits |= v;
-    }
-    /* get the n2 high limbs of abs(a) */
-    for (j = 0; j < n2; j++) {
-        i = j + n1;
-        if (i < 0) {
-            v = 0;
-        } else {
-            v = (a->tab[i] ^ (-sgn)) + carry;
-            carry = v < carry;
-        }
-        t[j] = v;
-    }
-
-    a1 = ((uint64_t)t[2] << 32) | t[1];
-    a0 = (uint64_t)t[0] << 32;
-    a0 |= (low_bits != 0);
