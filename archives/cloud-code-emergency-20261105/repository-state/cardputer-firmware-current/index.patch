-static void free_rp(JSRuntime *rt, JSRejectedPromiseEntry *rp)
-{
-    list_del(&rp->link);
-    JS_FreeValueRT(rt, rp->promise);
-    JS_FreeValueRT(rt, rp->reason);
-    js_free_rt(rt, rp);
-}
