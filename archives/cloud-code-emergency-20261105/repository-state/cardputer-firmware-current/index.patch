-        case DECOMP_TYPE_B18:
-            l = 18;
-            goto decomp_type_b;
-        case DECOMP_TYPE_B1:
-        case DECOMP_TYPE_B2:
-        case DECOMP_TYPE_B3:
-        case DECOMP_TYPE_B4:
-        case DECOMP_TYPE_B5:
-        case DECOMP_TYPE_B6:
-        case DECOMP_TYPE_B7:
-        case DECOMP_TYPE_B8:
-            l = type - DECOMP_TYPE_B1 + 1;
-decomp_type_b: {
-                uint32_t c_min;
-                c_min = unicode_get16(d);
-                d += 2 + (c - code) * l;
-                for (i = 0; i < l; i++) {
-                    c1 = d[i];
-                    if (c1 == 0xff) {
-                        c1 = 0x20;
-                    } else {
