-            return JS_UNDEFINED;
-        }
-        c = *r;
-        if (c == '-') {
-            if (r >= r_end) {
-                return JS_UNDEFINED;
-            }
-            r++;
-            c = *r;
-            /* -0 case is specific */
-            if (c == '0' && len == 2) {
-minus_zero:
