-static void js_free_shape0(JSRuntime *rt, JSShape *sh)
-{
-    uint32_t i;
-    JSShapeProperty *pr;
-
-    assert(sh->header.ref_count == 0);
-    if (sh->is_hashed) {
-        js_shape_hash_unlink(rt, sh);
