-static void skip_shebang(const uint8_t **pp, const uint8_t *buf_end)
-{
-    const uint8_t *p = *pp;
-    int c;
-
-    if (p[0] == '#' && p[1] == '!') {
-        p += 2;
-        while (p < buf_end) {
-            if (*p == '\n' || *p == '\r') {
-                break;
-            } else if (*p >= 0x80) {
-                c = utf8_decode(p, &p);
-                /* purposely ignore UTF-8 encoding errors in this comment line */
-                if (c == CP_LS || c == CP_PS) {
-                    break;
-                }
-            } else {
-                p++;
-            }
-        }
-        *pp = p;
-    }
-}
