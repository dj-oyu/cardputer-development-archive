-    print(f'{a.fw_elf}: {geo}, turns {d["first"]}..{d["first"] + n - 1}')
-    if iram:
-        print(f'  IRAM: {len(iram)} functions, {iram_bytes} B of DRAM')
-    if pack:
-        print(f'  packed: {len(pack)} functions, {pack_bytes} B')
-    if a.emit:
