-    js_slimb_t i;
-
-    if (n >= UDIV1NORM_THRESHOLD) {
-        js_limb_t b_inv;
-        b_inv = js_udiv1norm_init(b);
-        for (i = n - 1; i >= 0; i--) {
-            tabr[i] = js_udiv1norm(&r, r, taba[i], b, b_inv);
-        }
-    } else {
-        js_dlimb_t a1;
-        for (i = n - 1; i >= 0; i--) {
-            a1 = ((js_dlimb_t)r << JS_LIMB_BITS) | taba[i];
-            tabr[i] = a1 / b;
-            r = a1 % b;
-        }
