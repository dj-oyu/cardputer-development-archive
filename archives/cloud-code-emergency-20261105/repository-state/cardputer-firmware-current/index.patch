-    } else if(key==KEY_ENTER) {
-        if(category==0){sound_play(1);return true;}
-        const setting_t *entry=&settings[setting];
-        if(!choices) {
-            if(entry->kind==SETTING_ACTION) {
-                pending_screen=entry->screen;
-                sound_play(1);
