-        .id=atomic_fetch_add(&next_id,1),
-        .kind=-2,
-        .gain=(uint16_t)(gain*4096.0f),
-        .frames=frames,
-        .start_frame=start_frame,
-        .done=done,.ctx=ctx,
-        .stream=stream,.block=block};
