-        taba[0] = js_mp_div1norm(tabq, taba, na, b1, 0);
-        return;
-    }
-    n = na - nb;
-
-    if (n >= UDIV1NORM_THRESHOLD) {
-        b1_inv = js_udiv1norm_init(b1);
-    } else {
-        b1_inv = 0;
-    }
