-static int new_label_fd(JSFunctionDef *fd)
-{
-    int label;
-    LabelSlot *ls;
-
-    if (js_resize_array(fd->ctx, (void *)&fd->label_slots,
-                        sizeof(fd->label_slots[0]),
-                        &fd->label_size, fd->label_count + 1)) {
-        return -1;
-    }
-    label = fd->label_count++;
-    ls = &fd->label_slots[label];
-    ls->ref_count = 0;
-    ls->pos = -1;
-    ls->pos2 = -1;
