-    case RX_IDLE:
-        if(c==0x1d) rx_state=RX_TYPE;
-        return;
-    case RX_TYPE:
-        if(c==0x1d) return;                   // a restart inside a restart
-        if(c!='B') { rx_state=RX_SKIP; return; }
-        if(atomic_load(&inbox_head)-atomic_load(&inbox_tail)>=2) {
