-static int exported_names_cmp(const void *p1, const void *p2, void *opaque)
-{
-    JSContext *ctx = opaque;
-    const ExportedNameEntry *me1 = p1;
-    const ExportedNameEntry *me2 = p2;
-    JSValue str1, str2;
-    int ret;
