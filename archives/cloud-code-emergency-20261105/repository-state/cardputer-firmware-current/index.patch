-MDT = re.compile(r"MDT (\d+) (\w) t=(\d+) js=(\d+) rn=(\d+) sd=(\d+) by=(\d+) bd=(\d+) pr=(\d+) "
-                 r"reg=(\d+)/(\d+) prep=(\d+)/(\d+) un=(\d+) draw=(\d+)/(\d+)/(\d+) band=(\d+)/(\d+) "
-                 r"free=(\d+) lg=(\d+) k=([0-9a-f]+)/([0-9a-f]+)(?: mn=(\d+))?(?: gu=(\d+))?"
-                 r"(?: cv=(\d+)/(\d+)/(\d+))?")
