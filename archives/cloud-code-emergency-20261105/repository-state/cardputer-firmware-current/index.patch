-
-#ifdef ENABLE_DUMPS // JS_DUMP_READ_OBJECT
-static const char * const bc_tag_str[] = {
-    "invalid",
-    "null",
-    "undefined",
-    "false",
-    "true",
-    "int32",
-    "float64",
-    "string",
-    "object",
