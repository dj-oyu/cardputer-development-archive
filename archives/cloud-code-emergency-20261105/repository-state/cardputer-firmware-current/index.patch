-        if f and f[2] in fw:
-            s, z, n = f
-            fs, fz = fw[n]
-            return n, (addr - s) * fz // z
-        return (f[2] if f else '?'), None
-
-    blocks = []
-    for addrs in d['blocks']:
-        blocks.append([place(x) for x in list(addrs) + [addrs[-1] + 2]])
-
