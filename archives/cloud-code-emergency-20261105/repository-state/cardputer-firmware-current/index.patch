-                                             JSModuleDef **pmodule,
-                                             JSExportEntry **pme,
-                                             JSModuleDef *m,
-                                             JSAtom export_name)
-{
-    JSResolveState ss, *s = &ss;
-    int i;
-    JSResolveResultEnum ret;
-
-    s->array = NULL;
-    s->size = 0;
-    s->count = 0;
-
-    ret = js_resolve_export1(ctx, pmodule, pme, m, export_name, s);
-
-    for (i = 0; i < s->count; i++) {
-        JS_FreeAtom(ctx, s->array[i].name);
-    }
-    js_free(ctx, s->array);
-
