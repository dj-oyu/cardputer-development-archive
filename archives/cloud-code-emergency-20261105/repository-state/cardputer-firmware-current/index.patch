-    for (i = 0; i < fd->global_var_count; i++) {
-        hf = &fd->global_vars[i];
-        if (add_closure_var(ctx, fd, JS_CLOSURE_MODULE_DECL, i, hf->var_name, hf->is_const,
-                            hf->is_lexical, JS_VAR_NORMAL) < 0) {
-            return -1;
-        }
-    }
