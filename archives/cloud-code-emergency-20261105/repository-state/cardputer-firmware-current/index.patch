-    if (sh->proto != NULL) {
-        JS_FreeValueRT(rt, JS_MKPTR(JS_TAG_OBJECT, sh->proto));
-    }
-    pr = sh->prop;
-    for (i = 0; i < sh->prop_count; i++) {
-        JS_FreeAtomRT(rt, pr->atom);
-        pr++;
