-    bad=take_options(ctx,argc>2?argv[2]:JS_UNDEFINED,OP,&options);
-    if(!JS_IsUndefined(bad)) return bad;
-    bad=writable(ctx,&to,OP);
-    if(!JS_IsUndefined(bad)) return bad;
