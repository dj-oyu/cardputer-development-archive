-#define JS_VM_POLL_SAFEPOINT() do {                 \
-        int _vm_poll = js_poll_safepoint(ctx);      \
-        if (unlikely(_vm_poll == 2))                \
-            goto vm_yield;                          \
-        if (unlikely(_vm_poll != 0))                \
-            goto exception;                         \
-    } while (0)
