-    app_report();
-    if(p0_had_guest)ksn_p0_probe_report(overlay_session?"overlay":"app");
-#ifdef KASANE_PROC_JS_DIAGNOSTIC
-    if(news_prof_active){g_ksn_prof=news_prof_previous;news_prof_active=false;}
-#endif
