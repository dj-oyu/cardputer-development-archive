-#ifdef KASANE_P0_PROBE
-    if(p0_had_guest)pocket_mutex_arena_report();
-#endif
-#ifdef KASANE_P1_OUTPUT_OVERLAY_PROBE
-    if(p0_had_guest)p1_report_heap_holes();
