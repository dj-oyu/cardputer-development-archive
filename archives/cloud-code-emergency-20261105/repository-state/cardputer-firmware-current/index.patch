-#define ADDC(res, carry_out, op1, op2, carry_in)        \
-do {                                                    \
-    js_limb_t __v, __a, __k, __k1;                      \
-    __v = (op1);                                        \
-    __a = __v + (op2);                                  \
-    __k1 = __a < __v;                                   \
-    __k = (carry_in);                                   \
-    __a = __a + __k;                                    \
-    carry_out = (__a < __k) | __k1;                     \
-    res = __a;                                          \
-} while (0)
