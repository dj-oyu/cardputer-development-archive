-    if (rt->module_loader_has_attr) {
-        m = rt->u.module_loader_func2(ctx, cname, rt->module_loader_opaque, attributes);
-    } else {
-        m = rt->u.module_loader_func(ctx, cname, rt->module_loader_opaque);
