-       !(rom?ksn_proc_rom_plan_register_points_affine(plan,&coeff,&policy):
-             ksn_proc_sized_plan_register_points_affine(plan,&coeff,&policy))){
-        free(points);
-        return failure(ctx,op,POCKET_ERR_INVALID_ARGUMENT,"invalid typed point batch");
-    }
-    *out=points;
-    return JS_UNDEFINED;
-}
