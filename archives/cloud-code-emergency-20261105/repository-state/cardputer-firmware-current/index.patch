-    memset(&ms, 0, sizeof(ms));
-    ms.opaque = opaque;
-    ms.malloc_limit = 0;
-    /* A fresh runtime starts with a fresh canary: see g_oom_canary's comment
-     * for why this is process-wide state rather than a field of `ms`. */
-    g_oom_canary = (JSOOMCanary){0};
