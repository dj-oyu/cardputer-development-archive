-        case REOP_char32:
-            val = get_u32(pc);
-            pc += 4;
-            goto test_char;
-        case REOP_char16:
-            val = get_u16(pc);
-            pc += 2;
-            goto test_char;
-        case REOP_char8:
-            val = get_u8(pc);
-            pc += 1;
-test_char:
-            if (cptr >= cbuf_end) {
-                goto no_match;
-            }
-            GET_CHAR(c, cptr, cbuf_end, cbuf_type);
-            if (s->ignore_case) {
-                c = lre_canonicalize(c, s->is_unicode);
-            }
-            if (val != c) {
-                goto no_match;
-            }
-            break;
-        case REOP_split_goto_first:
