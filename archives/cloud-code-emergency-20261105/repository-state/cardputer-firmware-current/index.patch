-static const JSCFunctionListEntry file_methods[] = {
-    JS_CFUNC_DEF("read",   2, js_file_read),
-    JS_CFUNC_DEF("write",  2, js_file_write),
-    JS_CFUNC_DEF("seek",   2, js_file_seek),
-    JS_CFUNC_DEF("tell",   0, js_file_tell),
