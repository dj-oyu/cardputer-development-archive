-    }
-    max_size = (size_t) -1;
-    if (!JS_IsUndefined(max_size_val)) {
-        if (JS_ToIndex(ctx, &max_size64, max_size_val)) {
-            return JS_EXCEPTION;
-        }
-        if (max_size64 < max_size) {
-            max_size = max_size64;
-        }
-    }
-
-    js_std_dbuf_init(ctx, &dbuf);
-    while (max_size != 0) {
-        c = fgetc(f);
-        if (c == EOF) {
-            break;
-        }
-        if (dbuf_putc(&dbuf, c)) {
-            dbuf_free(&dbuf);
-            return JS_EXCEPTION;
-        }
-        max_size--;
-    }
-    if (magic) {
-        obj = JS_NewStringLen(ctx, (const char *)dbuf.buf, dbuf.size);
