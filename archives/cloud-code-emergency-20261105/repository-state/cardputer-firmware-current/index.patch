-static inline int64_t js__gettimeofday_us(void)
-{
-    struct timeval tv;
-#ifdef _WIN32
-    gettimeofday_msvc(&tv);
-#else
-    gettimeofday(&tv, NULL);
-#endif
-    return ((int64_t)tv.tv_sec * 1000000) + tv.tv_usec;
-}
