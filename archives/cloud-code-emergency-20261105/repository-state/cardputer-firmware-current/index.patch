-static grid_slot *find(JSContext *ctx, JSValueConst value)
-{
-    int64_t handle;
-    if (!number(ctx, value, 1, INT32_MAX, &handle)) return NULL;
-    for (unsigned i = 0; i < GRID_APP_SLOTS; ++i)
-        if (slots[i].handle == (uint32_t)handle) return &slots[i];
-    return NULL;
-}
