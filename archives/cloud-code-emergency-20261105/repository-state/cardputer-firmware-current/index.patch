-            length?POCKET_ERR_LIMIT_EXCEEDED:POCKET_ERR_INVALID_ARGUMENT,OP,
-            "data must be 1 to maxWriteBytes bytes",false,
-            POCKET_OUTCOME_NOT_APPLIED);
