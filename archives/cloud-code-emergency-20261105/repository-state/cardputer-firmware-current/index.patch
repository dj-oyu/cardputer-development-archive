-static uint32_t bridge_crc(const uint8_t *p, size_t n) {
-    uint32_t c=0xffffffffu;
-    while(n--) { c^=*p++; for(unsigned i=0;i<8;i++) c=(c>>1)^((0u-(c&1))&0xedb88320u); }
