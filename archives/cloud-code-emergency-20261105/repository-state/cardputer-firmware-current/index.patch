-    if (s->is_wide_char) {
-        str16(s->str)[s->len++] = c;
-    } else if (c < 0x100) {
-        str8(s->str)[s->len++] = c;
-    } else {
-        if (string_buffer_widen(s, s->size)) {
-            return -1;
-        }
-        str16(s->str)[s->len++] = c;
-    }
-    return 0;
