-    const char *op="kasane.procedural.register";
-    uint32_t count;
-    if((argc!=1&&argc!=2)||!array_length(ctx,argv[0],&count)||
-       !count||count>KSN_PROC_CODE)
-        return failure(ctx,op,POCKET_ERR_INVALID_ARGUMENT,"expected 1..64 instructions");
