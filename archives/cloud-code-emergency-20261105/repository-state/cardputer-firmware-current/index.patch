-static void emit_source_loc(JSParseState *s)
-{
-    JSFunctionDef *fd = s->cur_func;
-    DynBuf *bc = &fd->byte_code;
-
-    dbuf_putc(bc, OP_source_loc);
-    dbuf_put_u32(bc, s->token.line_num);
