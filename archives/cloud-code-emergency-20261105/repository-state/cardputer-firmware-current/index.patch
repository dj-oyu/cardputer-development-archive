-    for(unsigned core=0;core<FP_TICKET_CORES;core++) {
-        result.capacity_ppm[core]=m->capacity_ppm[core];
-    }
-    for(unsigned i=0;i<FP_TICKET_SLOTS;i++) {
-        unsigned bit=1u<<i;
-        if(!(m->live_mask & bit)) continue;
-        unsigned core=(m->core1_mask & bit) ? 1 : 0;
