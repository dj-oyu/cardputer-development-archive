-    tag = JS_VALUE_GET_TAG(val);
-    if (tag == JS_TAG_INT &&
-            (uint32_t)JS_VALUE_GET_INT(val) <= JS_ATOM_MAX_INT) {
-        /* fast path for integer values */
-        atom = __JS_AtomFromUInt32(JS_VALUE_GET_INT(val));
