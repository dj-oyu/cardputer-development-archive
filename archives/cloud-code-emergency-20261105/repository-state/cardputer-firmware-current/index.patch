-        case VIM_KEY_RIGHT:     c='l'; break;
-        case VIM_KEY_UP:        c='k'; break;
-        case VIM_KEY_DOWN:      c='j'; break;
-        case VIM_KEY_ENTER:     c='j'; break;
-        case VIM_KEY_BACKSPACE: c='h'; break;
