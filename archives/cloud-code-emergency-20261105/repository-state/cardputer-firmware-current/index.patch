-        r=clamp8(mul8(src.r,opacity)+mul8((r<<3)|(r>>2),inverse));
-        g=clamp8(mul8(src.g,opacity)+mul8((g<<2)|(g>>4),inverse));
-        b=clamp8(mul8(src.b,opacity)+mul8((b<<3)|(b>>2),inverse));
