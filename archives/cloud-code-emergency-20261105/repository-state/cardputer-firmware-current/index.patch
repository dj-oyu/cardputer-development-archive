-static __exception int js_parse_postfix_expr(JSParseState *s, int parse_flags);
-
-static __exception int js_parse_left_hand_side_expr(JSParseState *s)
-{
-    return js_parse_postfix_expr(s, PF_POSTFIX_CALL);
