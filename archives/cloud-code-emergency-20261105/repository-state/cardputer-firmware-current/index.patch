-        if (c < 0) {
-            return -1;
-        }
-        if ((p - buf) < buf_size - 1) {
-            *p++ = c;
-        }
-        if (dbuf) {
-            dbuf_putc(dbuf, c);
-        }
-        if (c == '\n') {
-            break;
-        }
-    }
-    *p = '\0';
-    return 0;
-}
