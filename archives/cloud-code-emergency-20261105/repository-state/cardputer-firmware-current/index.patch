-        ksn_proc_program program;
-        float input[KSN_PROC_INPUTS];
-        ksn_proc_vm vm;
-        ksn_proc_frame output;
-        if (!proc_mega_build(frame, layer, code, &program, input)) abort();
-        if (frame % 16u == 0 &&
-            !ksn_proc_plan_prepare(&plans[phase][layer], &program)) abort();
