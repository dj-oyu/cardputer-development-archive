-    struct list_head *el;
-    JSMapRecord *mr;
-
-    s = p->u.map_state;
-    if (s) {
-        assert(!s->is_weak);
-        list_for_each(el, &s->records) {
-            mr = list_entry(el, JSMapRecord, link);
-            JS_MarkValue(rt, mr->key, mark_func);
-            JS_MarkValue(rt, mr->value, mark_func);
-        }
-    }
