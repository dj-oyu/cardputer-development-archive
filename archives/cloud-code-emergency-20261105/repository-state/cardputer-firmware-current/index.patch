-
-    assert(!rt->in_free);
-
-    e = js_malloc(ctx, sizeof(*e) + argc * sizeof(JSValue));
-    if (!e) {
-        return -1;
-    }
-    e->ctx = ctx;
-    e->job_func = job_func;
-    e->argc = argc;
