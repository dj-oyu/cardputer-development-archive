-static __maybe_unused void dump_pc2line(JSContext *ctx,
-                                        const uint8_t *buf, int len,
-                                        int line_num, int col_num)
-{
-    const uint8_t *p_end, *p_next, *p;
-    int pc, v;
-    unsigned int op;
-
-    if (len <= 0) {
-        return;
-    }
-
-    printf("%5s %5s %5s\n", "PC", "LINE", "COLUMN");
-
-    p = buf;
-    p_end = buf + len;
-    pc = 0;
-    while (p < p_end) {
-        op = *p++;
-        if (op == 0) {
-            v = utf8_decode_len(p, p_end - p, &p_next);
-            if (v < 0) {
-                goto fail;
-            }
-            pc += v;
-            p = p_next;
-            v = utf8_decode_len(p, p_end - p, &p_next);
-            if (v < 0) {
-                goto fail;
-            }
-            if (v & 1) {
-                v = -(v >> 1) - 1;
-            } else {
-                v = v >> 1;
-            }
-            line_num += v;
-            p = p_next;
-        } else {
-            op -= PC2LINE_OP_FIRST;
-            pc += (op / PC2LINE_RANGE);
-            line_num += (op % PC2LINE_RANGE) + PC2LINE_BASE;
-        }
-        v = utf8_decode_len(p, p_end - p, &p_next);
-        if (v < 0) {
-            goto fail;
-        }
-        if (v & 1) {
-            v = -(v >> 1) - 1;
-        } else {
-            v = v >> 1;
-        }
-        col_num += v;
-        p = p_next;
-        printf("%5d %5d %5d\n", pc, line_num, col_num);
-    }
-    return;
-fail:
-    printf("invalid pc2line encode pos=%d\n", (int)(p - buf));
-}
