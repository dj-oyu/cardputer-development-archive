-        if(n<=0) { free(text); break; }
-        at+=(uint32_t)n;
-    }
-    if(at<src.size)
-        return pocket_api_reject(ctx,code?code:POCKET_ERR_CORRUPT_DATA,OP,
-                                 "the file could not be read",false,NULL);
