-      hint:mode===1?'ENTER SELECT   ESC HOME':mode===2?'ARROWS EDIT  ENTER SAVE':'L/R ACTION  ENTER DO  ESC SAVE/HOME',
-      bubble:sk,note:sk?note:'',reveal:sk?Math.min(note.length,Math.max(0,Math.floor((2400-(until-now))/70))):0});
-  }
