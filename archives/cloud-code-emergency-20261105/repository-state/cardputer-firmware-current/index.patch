-    // delivery is one period out rather than several at once.
-    w->next_us+=w->period_us;
-    if(w->next_us<round->now) w->next_us=round->now+w->period_us;
-    *payload=sample_object(ctx,round->sample,w->dropped);
-    return true;
-}
