-    {'~','!','@','#','$','%','^','&','*','(',')','_','+',  8},
-    {  9,'Q','W','E','R','T','Y','U','I','O','P','{','}','|'},
-    {  0,  0,'A','S','D','F','G','H','J','K','L',':','"',  10},
-    {  0,  0,  0,'Z','X','C','V','B','N','M','<','>','?',' '},
-};
