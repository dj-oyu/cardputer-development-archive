-static bool aligned_buffer(size_t count, void **raw, int16_t **aligned)
-{
-    *raw = malloc(count * sizeof(int16_t) + 15u);
-    if (!*raw) return false;
-    *aligned = (int16_t *)(((uintptr_t)*raw + 15u) & ~(uintptr_t)15u);
-    return true;
-}
