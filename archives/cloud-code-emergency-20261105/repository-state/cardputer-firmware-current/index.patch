-static bool code_has_label(CodeContext *s, int pos, int label)
-{
-    while (pos < s->bc_len) {
-        int op = s->bc_buf[pos];
-        if (op == OP_source_loc) {
-            pos += 9;
-            continue;
-        }
-        if (op == OP_label) {
-            int lab = get_u32(s->bc_buf + pos + 1);
-            if (lab == label) {
-                return true;
-            }
-            pos += 5;
-            continue;
-        }
-        if (op == OP_goto) {
-            int lab = get_u32(s->bc_buf + pos + 1);
-            if (lab == label) {
-                return true;
-            }
-        }
-        break;
-    }
-    return false;
-}
