-        rmt_disable(ir_channel);
-        JS_FreeValue(ctx,options.cancel);
-        return pocket_api_reject(ctx,POCKET_ERR_IO_ERROR,OP,esp_err_to_name(e),
-                                 true,POCKET_OUTCOME_NOT_APPLIED);
-    }
