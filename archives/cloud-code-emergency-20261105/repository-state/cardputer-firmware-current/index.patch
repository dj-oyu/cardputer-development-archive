-static js_limb_t js_mp_add(js_limb_t *res, const js_limb_t *op1, const js_limb_t *op2,
-                           js_limb_t n, js_limb_t carry)
-{
-    int i;
-    for (i = 0; i < n; i++) {
-        ADDC(res[i], carry, op1[i], op2[i], carry);
-    }
-    return carry;
-}
