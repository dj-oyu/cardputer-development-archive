-#define PROP_TYPE_IDENT 0
-#define PROP_TYPE_VAR   1
-#define PROP_TYPE_GET   2
-#define PROP_TYPE_SET   3
-#define PROP_TYPE_STAR  4
-#define PROP_TYPE_ASYNC 5
-#define PROP_TYPE_ASYNC_STAR 6
-
-#define PROP_TYPE_PRIVATE (1 << 4)
