-        rmt_disable(ir_channel);
-        JS_FreeValue(ctx,options.cancel);
-        return pocket_api_reject(ctx,POCKET_ERR_BUSY,OP,
-                                 "too many operations are pending",true,
-                                 POCKET_OUTCOME_NOT_APPLIED);
-    }
