-            p = ((type - DECOMP_TYPE_I2_0) & 1) + (l > 2);
-decomp_type_i:
-            for (i = 0; i < l; i++) {
-                c1 = unicode_get16(d + 2 * i);
-                if (i == p) {
-                    c1 += c - code;
-                }
-                res[i] = c1;
-            }
