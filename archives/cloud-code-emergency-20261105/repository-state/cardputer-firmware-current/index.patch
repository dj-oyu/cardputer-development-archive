-    else if (!strcmp(a, "--require-frame")) require_frame = true;
-    else if (!strcmp(a, "--module")) module = true;
-    else if (!strcmp(a, "--strict")) strict = true;
-    else if (!strcmp(a, "--test262")) test262 = true;
