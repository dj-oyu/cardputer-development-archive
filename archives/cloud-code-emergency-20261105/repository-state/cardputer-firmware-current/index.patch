-// |p| must be a typed array, *not* a DataView
-static bool typed_array_is_immutable(JSObject *p)
-{
-    JSArrayBuffer *abuf;
-    JSTypedArray *ta;
-
-    assert(is_typed_array(p->class_id));
-    ta = p->u.typed_array;
-    abuf = ta->buffer->u.array_buffer;
-    return abuf->immutable;
-}
