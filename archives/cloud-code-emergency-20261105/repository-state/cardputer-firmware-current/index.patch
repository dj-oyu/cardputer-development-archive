-  for (size_t index = 0; index < count; ++index) {
-    if (JS_SetPropertyUint32(context, array, (uint32_t)index,
-                             JS_NewUint32(context, values[index])) < 0) {
-      JS_FreeValue(context, array);
-      return JS_EXCEPTION;
-    }
-  }
-  return array;
-}
