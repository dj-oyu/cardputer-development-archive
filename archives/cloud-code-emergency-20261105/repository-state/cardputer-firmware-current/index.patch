-    // ---- escapes: every one of these must be refused -------------------------
-    static const char *escapes[] = {
-        "..", "../", "../x", "a/..", "a/../..", "a/../../etc",
-        ".", "./x", "a/./b", "/abs", "a/", "a//b", "\\", "a\\b", "..\\..",
-    };
