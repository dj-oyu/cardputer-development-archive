-    return JS_UNDEFINED;
-}
-
-// __pjs_error(message, stack) — the frame wrapper's way of handing an exception
-// to the host before rethrowing it.
-static JSValue host_error(JSContext *ctx, JSValueConst this_val,
-                          int argc, JSValueConst *argv) {
-    (void)this_val;
