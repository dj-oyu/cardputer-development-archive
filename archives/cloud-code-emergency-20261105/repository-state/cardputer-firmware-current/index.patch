-            case '\'':
-            case '\"':
-            case '\\':
-                p++;
-                break;
-            case '\r':  /* accept DOS and MAC newline sequences */
-                if (p[1] == '\n') {
-                    p++;
-                }
-            /* fall thru */
-            case '\n':
-                /* ignore escaped newline sequence */
-                p++;
