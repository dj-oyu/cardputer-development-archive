-static RelocEntry *add_reloc(JSContext *ctx, LabelSlot *ls, uint32_t addr, int size)
-{
-    RelocEntry *re;
-    re = js_malloc(ctx, sizeof(*re));
-    if (!re) {
-        return NULL;
-    }
-    re->addr = addr;
-    re->size = size;
-    re->next = ls->first_reloc;
-    ls->first_reloc = re;
-    return re;
-}
