-    REQUIRE(ksn_proc_rom_plan_begin(v,a,input,f)==KSN_PROC_RUNNING);
-    REQUIRE(ksn_proc_rom_plan_run(v,b,false)==KSN_PROC_DONE&&fallbacks==1);
