-typedef enum { MP3_SD_WAIT, MP3_SD_MORE, MP3_SD_EOF,
-               MP3_SD_ERROR, MP3_SD_CANCEL } mp3_sd_step_t;
-typedef struct {
-    sound_stream_t *packets;
-    uint32_t at, end;
