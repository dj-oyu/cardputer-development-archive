-    surface_t **slot = &guest->surfaces;
-    while (*slot && *slot != entry)
-      slot = &(*slot)->next;
-    if (*slot)
-      *slot = entry->next;
-    free(entry->name);
-    free(entry);
-  }
-  return result;
