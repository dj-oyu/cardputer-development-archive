-    size_t size;
-    ssize_t ret;
-    uint8_t *buf;
-
-    if (JS_ToInt32(ctx, &fd, argv[0])) {
-        return JS_EXCEPTION;
-    }
-    if (JS_ToIndex(ctx, &pos, argv[2])) {
-        return JS_EXCEPTION;
-    }
-    if (JS_ToIndex(ctx, &len, argv[3])) {
-        return JS_EXCEPTION;
-    }
-    buf = JS_GetArrayBuffer(ctx, &size, argv[1]);
-    if (!buf) {
-        return JS_EXCEPTION;
