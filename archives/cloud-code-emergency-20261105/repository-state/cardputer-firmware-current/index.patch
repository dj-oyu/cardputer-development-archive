-        return JS_EXCEPTION;
-    }
-    *scene=(kasane_scene){.build=build,.patch=patch,.refs=JS_NULL,.candidate=JS_NULL,
-                          .model=JS_UNDEFINED,.dirty=true,.rebuild=true};
-    JS_SetOpaque(out,scene);
