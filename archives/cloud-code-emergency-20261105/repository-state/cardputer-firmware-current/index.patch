-/* WARNING: d must be >= 2^(JS_LIMB_BITS-1) */
-static inline js_limb_t js_udiv1norm_init(js_limb_t d)
-{
-    js_limb_t a0, a1;
-    a1 = -d - 1;
-    a0 = -1;
-    return (((js_dlimb_t)a1 << JS_LIMB_BITS) | a0) / d;
