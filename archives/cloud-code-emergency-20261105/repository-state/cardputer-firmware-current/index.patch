-    GARDEN_FENCE;garden_veg_cycles+=PROF_CC()-vt2;
-    garden_veg_rows++;garden_veg_passes+=2;GARDEN_FENCE;
-#endif
-    for(int x=0;x<240;x++)row[x]=garden_mix(row[x],next[x],mix);
-}
