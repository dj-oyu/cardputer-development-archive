-  [ "$match" = "$want_match" ] || ok=0
-  case "$want_hits" in 0) [ "${hits:-x}" = 0 ] || ok=0 ;; '>0') [ "${hits:-0}" -gt 0 ] || ok=0 ;; esac
-  case "$want_fails" in 0) [ "${fails:-x}" = 0 ] || ok=0 ;; '>0') [ "${fails:-0}" -gt 0 ] || ok=0 ;; esac
-  checks=$((checks + 1))
