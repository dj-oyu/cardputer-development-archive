-static bool string_get_tzabbr(const uint8_t *sp, int *pp, int *offset)
-{
-    size_t i;
-
-    for (i = 0; i < countof(js_tzabbr); i++) {
-        if (string_match(sp, pp, js_tzabbr[i].name)) {
