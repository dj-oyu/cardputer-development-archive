-                if(v->op) apply_operator(v,d,v->op,m);
-                else { d->cursor=m.at; v->want_col=(uint16_t)-1; vim_clamp(v,d); }
-            }
-            clear_pending(v);
-            return VIM_ACT_NONE;
-        }
-    }
