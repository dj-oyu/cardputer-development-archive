-  // still cached at exit go back to malloc before the leak check looks.
-  storage_init();
-  atexit(storage_fini);
-  size_t heap_limit = 160U * 1024U;  // main/app_session.c gc.heap_limit
-  size_t stack_limit = 20U * 1024U;  // main/app_session.c gc.stack_limit
