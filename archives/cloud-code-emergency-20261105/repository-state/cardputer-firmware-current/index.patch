-static JSValue js_atomics_op(JSContext *ctx,
-                             JSValueConst this_obj,
-                             int argc, JSValueConst *argv, int op)
-{
-    int size_log2;
-    uint64_t v, a, rep_val, idx;
-    void *ptr;
-    JSObject *p;
-    JSValue ret;
-
-    p = js_atomics_get_buf(ctx, argv[0], argv[1], NULL, &idx, 0);
