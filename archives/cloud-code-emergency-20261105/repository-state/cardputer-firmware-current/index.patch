-static void field_steps(uint16_t a,uint16_t b,unsigned *worst){
-    static const unsigned sh[3]={11,5,0},mask[3]={31,63,31};
-    for(unsigned c=0;c<3;c++){
-        unsigned x=(a>>sh[c])&mask[c],y=(b>>sh[c])&mask[c];
