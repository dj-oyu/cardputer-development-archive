-        emit_op(s, OP_push_false); /* will be patched later */
-        cf->brand_push_pos = cf->fields_init_fd->last_opcode_pos;
-        label_add_brand = emit_goto(s, OP_if_false, -1);
-
-        emit_op(s, OP_scope_get_var);
-        emit_atom(s, JS_ATOM_this);
-        emit_u16(s, 0);
