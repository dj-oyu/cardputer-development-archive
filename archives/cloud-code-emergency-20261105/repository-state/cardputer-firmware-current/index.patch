-static void safe_close(FILE *f, bool is_popen)
-{
-    if (!f) {
-        return;
-    }
-    if (is_stdio(f)) {
-        return;
-    }
-    if (is_popen) {
-#if !defined(__wasi__) && !defined(ESP_PLATFORM)
-        pclose(f);
-#endif
