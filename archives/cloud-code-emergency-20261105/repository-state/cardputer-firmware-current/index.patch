-    DynBuf dbuf;
-    JSValue obj;
-
-    if (!f) {
-        return JS_EXCEPTION;
-    }
-
-    js_std_dbuf_init(ctx, &dbuf);
-    for (;;) {
-        c = fgetc(f);
-        if (c == EOF) {
-            if (dbuf.size == 0) {
-                /* EOF */
-                dbuf_free(&dbuf);
-                return JS_NULL;
-            } else {
-                break;
-            }
-        }
-        if (c == '\n') {
-            break;
-        }
-        if (dbuf_putc(&dbuf, c)) {
-            dbuf_free(&dbuf);
-            return JS_ThrowOutOfMemory(ctx);
-        }
-    }
-    obj = JS_NewStringLen(ctx, (const char *)dbuf.buf, dbuf.size);
-    dbuf_free(&dbuf);
-    return obj;
-}
