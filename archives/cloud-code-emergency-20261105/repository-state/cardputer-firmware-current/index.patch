-    HUD_FENCE;uint32_t h0=esp_cpu_get_cycle_count();HUD_FENCE;
-    if(show_fps)text(194,8,ctx->meter,1,ctx->muted);
-    HUD_FENCE;uint32_t h1=esp_cpu_get_cycle_count();HUD_FENCE;
