-static unsigned eff_count(const vim_state_t *v) {
-    unsigned a=v->count1?v->count1:1, b=v->count2?v->count2:1;
-    unsigned n=a*b;
-    // Bounded so a mistyped count cannot walk the buffer thousands of times.
-    return n?(n>9999?9999:n):1;
-}
