-// const C (docs/kasane/flash-plan.md). Host only (Node 16 or later).
-//
-//   node tools/kasane_ir/emit_rom_plans.mjs OUT.c APP=FILE.js [APP=FILE.js ...]
-//        [--symbol NAME] [--json OUT.json]
