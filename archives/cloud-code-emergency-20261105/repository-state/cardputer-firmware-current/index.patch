-static __exception int JS_CopyDataProperties(JSContext *ctx,
-                                             JSValue target,
-                                             JSValue source,
-                                             JSValue excluded,
-                                             bool setprop)
-{
-    JSPropertyEnum *tab_atom;
-    JSValue val;
-    uint32_t i, tab_atom_count;
-    JSObject *p;
-    JSObject *pexcl = NULL;
-    int ret, gpn_flags;
-    int desc_flags;
-    bool is_enumerable;
