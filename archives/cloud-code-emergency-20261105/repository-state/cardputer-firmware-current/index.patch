-        if (p->class_id == JS_CLASS_DATE) {
-            JS_FreeValue(ctx, p->u.object_data);
-            p->u.object_data = js_float64(v);
-            return js_dup(p->u.object_data);
-        }
-    }
-    return JS_ThrowTypeError(ctx, "not a Date object");
-}
