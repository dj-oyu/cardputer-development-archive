-/* return the combining class of character c (between 0 and 255) */
-static int unicode_get_cc(uint32_t c)
-{
-    uint32_t code, n, type, cc, c1, b;
-    int pos;
-    const uint8_t *p;
-
-    pos = get_index_pos(&code, c,
-                        unicode_cc_index, sizeof(unicode_cc_index) / 3);
-    if (pos < 0) {
-        return 0;
-    }
-    p = unicode_cc_table + pos;
-    for (;;) {
-        b = *p++;
-        type = b >> 6;
-        n = b & 0x3f;
-        if (n < 48) {
-        } else if (n < 56) {
-            n = (n - 48) << 8;
-            n |= *p++;
-            n += 48;
-        } else {
-            n = (n - 56) << 8;
-            n |= *p++ << 8;
-            n |= *p++;
-            n += 48 + (1 << 11);
-        }
-        if (type <= 1) {
-            p++;
-        }
-        c1 = code + n + 1;
-        if (c < c1) {
-            switch (type) {
-            case 0:
-                cc = p[-1];
-                break;
-            case 1:
-                cc = p[-1] + c - code;
-                break;
-            case 2:
-                cc = 0;
-                break;
-            default:
-            case 3:
-                cc = 230;
-                break;
-            }
-            return cc;
-        }
-        code = c1;
-    }
-}
