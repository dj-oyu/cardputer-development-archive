-static int JS_WriteRegExp(BCWriterState *s, JSRegExp regexp)
-{
-    JSString *bc = regexp.bytecode;
-    assert(!bc->is_wide_char);
-    JS_WriteString(s, regexp.pattern);
-    JS_WriteString(s, bc);
-    return 0;
-}
