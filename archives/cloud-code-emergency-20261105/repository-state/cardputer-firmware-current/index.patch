-    if(!alpha)return original;
-    bg[0]=bg[0]*8+bg[0]/4;bg[1]=bg[1]*4+bg[1]/16;bg[2]=bg[2]*8+bg[2]/4;
-    for(unsigned c=0;c<3;c++)p[c]=limited(product(p[c],ref_opacity)+product(bg[c],255-alpha));
