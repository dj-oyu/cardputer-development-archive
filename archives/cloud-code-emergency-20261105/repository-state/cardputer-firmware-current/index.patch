-static int http_get_status(const char *buf)
-{
-    const char *p = buf;
-    while (*p != ' ' && *p != '\0') {
-        p++;
-    }
-    if (*p != ' ') {
-        return 0;
-    }
-    while (*p == ' ') {
-        p++;
-    }
-    return atoi(p);
-}
