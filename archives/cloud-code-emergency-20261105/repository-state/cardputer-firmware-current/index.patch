-    pie_finish(dest, p->final_shift);
-#else
-    for (unsigned lane = 0; lane < 8; ++lane)
-        dest[lane] = extract(accum[lane], p->final_shift);
-#endif
-    TRACE(KSN_GRID_TRACE_FINISH, dest, NULL, p->final_shift);
-}
