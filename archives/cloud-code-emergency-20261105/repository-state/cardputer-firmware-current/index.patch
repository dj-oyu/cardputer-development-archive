-/* 1 <= shift <= JS_LIMB_BITS - 1 */
-static js_limb_t js_mp_shl(js_limb_t *tabr, const js_limb_t *taba, int n,
-                           int shift)
-{
-    int i;
-    js_limb_t l, v;
-    l = 0;
-    for (i = 0; i < n; i++) {
-        v = taba[i];
-        tabr[i] = (v << shift) | l;
-        l = v >> (JS_LIMB_BITS - shift);
-    }
-    return l;
-}
