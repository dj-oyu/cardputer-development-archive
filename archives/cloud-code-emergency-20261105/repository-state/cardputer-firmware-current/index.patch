-    case '<':
-        if (p[1] == '=') {
-            p += 2;
-            s->token.val = TOK_LTE;
-        } else if (p[1] == '<') {
-            if (p[2] == '=') {
-                p += 3;
-                s->token.val = TOK_SHL_ASSIGN;
-            } else {
-                p += 2;
-                s->token.val = TOK_SHL;
-            }
-        } else if (s->allow_html_comments &&
-                   p[1] == '!' && p[2] == '-' && p[3] == '-') {
-            /* Annex B: handle `<!--` single line html comments */
-            goto skip_line_comment;
-        } else {
-            goto def_token;
-        }
