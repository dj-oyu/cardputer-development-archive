-    {
-        shift = clz64(a1);
-        if (shift != 0) {
-            a1 = (a1 << shift) | (a0 >> (64 - shift));
-            a0 <<= shift;
-        }
-    }
-    a1 |= (a0 != 0); /* keep the bits for the final rounding */
-    /* compute the exponent */
-    e = a->len * JS_LIMB_BITS - shift - 1;
-    *pexp = e;
-    return a1;
-}
