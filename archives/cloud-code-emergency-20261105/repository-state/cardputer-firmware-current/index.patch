- * version on this host. This override only changes the metadata stride and
- * the block-search bucket boundaries the algorithm evaluates against, not
- * the fit strategy or split/coalesce logic, which are unmodified below. */
-#ifndef VMALLOC_TLSF_ALIGN_LOG2
-#define VMALLOC_TLSF_ALIGN_LOG2 2
-#endif
