-    if(forced_failure){
-        flower_frame_destroy(flower_scene_frames[next]);
-        flower_scene_frames[next]=NULL;
-    }
-#else
-    bool forced_failure=false;
-#endif
-    if(!forced_failure&&!flower_scene_frames[next])
-        flower_scene_frames[next]=flower_frame_create();
