-                                       int *pexp, const JSBigInt *a)
-{
-    js_limb_t t[4 - JS_LIMB_BITS / 32], carry, v, low_bits;
-    int n1, n2, sgn, shift, i, j, e;
-    uint64_t a1, a0;
-
-    n2 = 4 - JS_LIMB_BITS / 32;
-    n1 = a->len - n2;
-    sgn = js_bigint_sign(a);
