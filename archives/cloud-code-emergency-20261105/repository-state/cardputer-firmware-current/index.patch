-
-    sh = js_new_shape2(ctx, proto, JS_PROP_INITIAL_HASH_SIZE, prop_count);
-    if (sh)
-        for (i = 0; i < prop_count; i++)
-            if (add_shape_property(ctx, &sh, NULL, props[i].atom, props[i].flags)) {
