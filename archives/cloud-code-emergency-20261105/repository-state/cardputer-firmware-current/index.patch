-/* 0 <= c <= 0x10ffff */
-static inline int string_buffer_putc(StringBuffer *s, uint32_t c)
-{
-    if (likely(s->len < s->size)) {
-        if (s->is_wide_char) {
-            if (c < 0x10000) {
-                str16(s->str)[s->len++] = c;
-                return 0;
-            } else if (s->len + 1 < s->size) {
-                /* surrogate pair */
-                str16(s->str)[s->len++] = get_hi_surrogate(c);
-                str16(s->str)[s->len++] = get_lo_surrogate(c);
-                return 0;
-            }
-        } else if (c < 0x100) {
-            str8(s->str)[s->len++] = c;
-            return 0;
-        }
