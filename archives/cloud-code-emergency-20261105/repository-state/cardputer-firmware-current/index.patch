-    gcc -O2 -w -c -DOPUS_BUILD -DVAR_ARRAYS=1 -DOPUS_VERSION='"host"' \
-        -I"$SRC/include" -I"$SRC" -I"$SRC/celt" -I"$SRC/silk" -I"$SRC/silk/float" \
-        "${SRCS[@]}"
