-static uint64_t hash_word(uint64_t hash, uint64_t value)
-{
-    for (unsigned byte = 0; byte < 8; ++byte) {
-        hash ^= (uint8_t)(value >> (byte * 8u));
-        hash *= UINT64_C(1099511628211);
-    }
-    return hash;
-}
