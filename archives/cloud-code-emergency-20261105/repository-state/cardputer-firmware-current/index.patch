-                s->memory_used_size += sizeof(*fd) + fd->data_len * sizeof(*fd->data);
-            }
-        }
-        break;
-        case JS_CLASS_C_CLOSURE: { /* u.c_closure_record */
-            JSCClosureRecord *c = p->u.c_closure_record;
-            if (c) {
