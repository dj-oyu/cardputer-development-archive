-        JS_DefinePropertyValue(ctx, error_obj, JS_ATOM_stack, stack,
-                               JS_PROP_WRITABLE | JS_PROP_CONFIGURABLE);
-    } else {
-        JS_FreeValue(ctx, stack);
-    }
