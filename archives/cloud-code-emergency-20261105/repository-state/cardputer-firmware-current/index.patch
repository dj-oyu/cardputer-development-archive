-}
-
-vim_action_t vim_feed(vim_state_t *v, vim_doc_t *d, vim_key_t k) {
-    v->msg[0]=0;
-    switch(v->mode) {
-        case VIM_INSERT:  return insert_key(v,d,k);
-        case VIM_CMDLINE: return cmdline_key(v,d,k);
-        default:          return normal_key(v,d,k);
-    }
-}
