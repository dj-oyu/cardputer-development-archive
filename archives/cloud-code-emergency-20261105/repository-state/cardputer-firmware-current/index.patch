-{
-    if (c >= 0x10000) {
-        /* surrogate pair */
-        if (string_buffer_putc16(s, get_hi_surrogate(c))) {
-            return -1;
-        }
-        c = get_lo_surrogate(c);
-    }
-    return string_buffer_putc16(s, c);
