-
-int vmtest_vmstack_set_budget(JSRuntime *rt, size_t bytes)
-{
-    JSVMStack *st = js_vm_stack_get(rt);
-    if (!st)
-        return -1;
-    st->budget = bytes;
-    return 0;
-}
-
-void vmtest_vmstack_report(JSRuntime *rt, void *out)
