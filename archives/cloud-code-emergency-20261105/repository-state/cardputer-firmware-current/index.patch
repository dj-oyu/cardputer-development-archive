-     * prepare state is never used to repair a partially transferred frame. */
-    flower_scene_use_committed=!flower_scene_candidate&&flower_scene_has_committed;
-#ifdef KASANE_FLOWER_D1_PROBE
-    if(flower_d1_pressure_active) {
