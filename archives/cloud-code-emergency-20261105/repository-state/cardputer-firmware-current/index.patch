-enum tlsf_config
-{
-	/* All allocation sizes and addresses are aligned to 4 bytes. */
-	ALIGN_SIZE_LOG2 = VMALLOC_TLSF_ALIGN_LOG2,
-	ALIGN_SIZE = (1 << ALIGN_SIZE_LOG2),
-};
