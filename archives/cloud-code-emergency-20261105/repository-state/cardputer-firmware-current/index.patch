-            }
-        }
-    } else {
-        if (!JS_IsFunction(ctx, func)) {
-            return JS_ThrowTypeError(ctx, "not a function");
-        }
-        rh = find_rh(ts, fd);
-        if (!rh) {
-            rh = js_mallocz(ctx, sizeof(*rh));
-            if (!rh) {
-                return JS_EXCEPTION;
-            }
-            rh->fd = fd;
