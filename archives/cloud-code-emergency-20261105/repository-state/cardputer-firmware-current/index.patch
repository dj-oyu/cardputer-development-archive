-uint32_t skk_crc32(uint32_t seed, const void *data, size_t len)
-{
-    const uint8_t *p = (const uint8_t *)data;
-    uint32_t crc = ~seed;
-    size_t i;
-
-    if (!p) {
-        return seed;
-    }
-    for (i = 0; i < len; i++) {
-        crc ^= p[i];
-        crc = (crc >> 4) ^ s_crc_nib[crc & 0x0Fu];
-        crc = (crc >> 4) ^ s_crc_nib[crc & 0x0Fu];
-    }
-    return ~crc;
-}
