-    r"width=(\d+) height=(\d+) taps_x=(\d+) taps_y=(\d+) "
-    r"calls_per_backend=(\d+) scalar_us=(\d+) gather_us=(\d+) "
-    r"affine_us=(\d+) fused_us=(-?\d+)"
