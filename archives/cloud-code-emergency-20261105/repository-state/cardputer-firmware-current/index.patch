-const FIELD = {a: 0, value: 1, color: 2};  // ksn_proc_field
-const PARAMS = 8, CODE = 64;
-
-const decoder = (() => {
-  const ctx = {};
-  vm.createContext(ctx);
-  vm.runInContext(DECODER_NIBBLE + 'globalThis.__dec = prog;', ctx);
-  return ctx.__dec;
-})();
