-static js_limb_t js_mp_sub(js_limb_t *res, const js_limb_t *op1, const js_limb_t *op2,
-                           int n, js_limb_t carry)
-{
-    int i;
-    js_limb_t k, a, v, k1;
-
-    k = carry;
-    for (i = 0; i < n; i++) {
-        v = op1[i];
-        a = v - op2[i];
-        k1 = a > v;
-        v = a - k;
-        k = (v > a) | k1;
-        res[i] = v;
-    }
-    return k;
-}
