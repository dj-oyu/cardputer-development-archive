-
-static unsigned memory_class(const void *pointer)
-{
-#ifdef ESP_PLATFORM
-    return esp_ptr_internal(pointer) ? 1u :
-           esp_ptr_external_ram(pointer) ? 2u : 0u;
-#else
-    (void)pointer;
-    return 1u; /* host PIE model uses the internal-memory profile class */
-#endif
