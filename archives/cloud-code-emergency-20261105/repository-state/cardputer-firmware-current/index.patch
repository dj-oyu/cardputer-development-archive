-    // because every one of them takes an arbitrary character, digits included.
-    if(v->pending) {
-        char p=v->pending;
-        v->pending=0;
-        if(p=='g') {
-            if(c=='g') {
-                motion_t m=motion_for(v,d,'g',eff_count(v),v->op);
-                if(v->op) apply_operator(v,d,v->op,m);
