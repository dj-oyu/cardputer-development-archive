-    if(!mix) {
-#if PROF_ON
-        GARDEN_FENCE;uint32_t vt1=PROF_CC();GARDEN_FENCE;
-#endif
-        garden_vegetation_row(row,y,f,old_seed);
-#if PROF_ON
-        GARDEN_FENCE;garden_veg_cycles+=PROF_CC()-vt1;
-        garden_veg_rows++;garden_veg_passes++;GARDEN_FENCE;
-#endif
-        return;
