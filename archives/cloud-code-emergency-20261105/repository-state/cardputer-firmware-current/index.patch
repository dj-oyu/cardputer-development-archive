-    link.open=false;
-    pocket_api_sub_close_all(&event_table);
-    for(int i=0;i<BRIDGE_CALLS;i++)
-        if(calls[i].request&&!calls[i].posted) {
-            calls[i].posted=true;
-            pocket_api_complete(calls[i].request,BRIDGE_STATUS_STOPPED);
