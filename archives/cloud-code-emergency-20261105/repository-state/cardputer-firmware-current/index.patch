-/* flags for js_os_poll_internal */
-#define JS_OS_POLL_RUN_TIMERS  (1 << 0)
-#define JS_OS_POLL_WORKERS     (1 << 1)
-#define JS_OS_POLL_SIGNALS     (1 << 2)
