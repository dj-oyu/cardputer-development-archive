-    if (is_template) {
-        val = JS_ReadObjectRec(s);
-        if (JS_IsException(val)) {
-            goto fail;
-        }
-        if (!JS_IsUndefined(val)) {
-            ret = JS_DefinePropertyValue(ctx, obj, JS_ATOM_raw, val, 0);
-            if (ret < 0) {
-                goto fail;
-            }
-        }
-        JS_PreventExtensions(ctx, obj);
