-static int js_cmp_doubles(double x, double y)
-{
-    if (isnan(x)) {
-        return isnan(y) ? 0 : +1;
-    }
-    if (isnan(y)) {
-        return -1;
-    }
-    if (x < y) {
-        return -1;
-    }
-    if (x > y) {
-        return 1;
-    }
-    if (x != 0) {
-        return 0;
-    }
-    if (signbit(x)) {
-        return signbit(y) ? 0 : -1;
-    } else {
-        return signbit(y) ? 1 : 0;
-    }
-}
