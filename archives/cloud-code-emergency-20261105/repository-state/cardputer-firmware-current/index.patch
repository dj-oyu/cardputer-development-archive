-        if(v->op) { clear_pending(v); return VIM_ACT_NONE; }
-        apply_operator(v,d,op,m);
-        clear_pending(v);
-        return VIM_ACT_NONE;
-    }
-    if(c=='Y'||c=='S') {
-        if(v->op) { clear_pending(v); return VIM_ACT_NONE; }
