-    /* optional separator between digits */
-    sep = (flags & JS_ATOD_ACCEPT_UNDERSCORES) ? '_' : 256;
-
-    p = str;
-    is_neg = 0;
-    if (p[0] == '+') {
-        p++;
-        p_start = p;
-    } else if (p[0] == '-') {
-        is_neg = 1;
-        p++;
-        p_start = p;
-    } else {
-        p_start = p;
-    }
