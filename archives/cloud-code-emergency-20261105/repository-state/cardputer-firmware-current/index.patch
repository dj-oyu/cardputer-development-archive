-    JSOSRWHandler *rh;
-    int fd;
-    JSValueConst func;
-
-    if (JS_ToInt32(ctx, &fd, argv[0])) {
-        return JS_EXCEPTION;
-    }
-    func = argv[1];
-    if (JS_IsNull(func)) {
-        rh = find_rh(ts, fd);
