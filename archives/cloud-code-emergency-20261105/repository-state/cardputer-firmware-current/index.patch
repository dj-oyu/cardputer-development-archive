-    for (i = 0; i < s->label_count; i++) {
-        assert(label_slots[i].first_reloc == NULL);
-    }
-
-    /* more jump optimizations */
-    patch_offsets = 0;
-    for (i = 0, jp = s->jump_slots; i < s->jump_count; i++, jp++) {
-        LabelSlot *ls;
-        JumpSlot *jp1;
-        int j, pos, diff, delta;
