-    if (js_resize_array(ctx, (void **)&s->closure_var,
-                        sizeof(s->closure_var[0]),
-                        &s->closure_var_size, s->closure_var_count + 1)) {
-        return -1;
-    }
-    cv = &s->closure_var[s->closure_var_count++];
-    cv->closure_type = closure_type;
