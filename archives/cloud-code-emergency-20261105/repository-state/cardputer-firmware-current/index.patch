-    CHECK(!sd_generation_valid(&m, 0), "generation 0 accepted");
-    CHECK(build(&m, "a", buf, sizeof buf) == SD_PATH_NO_GRANT, "no grant not refused");
-
-    // ---- grant before media: still refuses, and with the ungranted reason ----
