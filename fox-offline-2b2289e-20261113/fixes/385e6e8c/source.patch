+#include <assert.h>
+/* Single UI producer; pointers refer to a pinned immutable snapshot and the
+ * exclusive scratch, never to automatic storage. disp_join orders completion. */
+static struct {
+ const fox_eye_snapshot *snapshot;
+ render_scratch *scratch;
+ bool active,finished,ok;
+} preflight_job;
+static esp_err_t preflight_run(void){
+ return prepare_frame(preflight_job.snapshot,preflight_job.scratch)?ESP_OK:ESP_FAIL;
+}
+static void preflight_finish(esp_err_t result){
+ assert(preflight_job.active&&!preflight_job.finished);
+ preflight_job.ok=result==ESP_OK;preflight_job.finished=true;
+}
+static bool prepare_cursor_frame(const fox_eye_snapshot *s,render_scratch *w){
+ assert(!preflight_job.active);
+ disp_join();
+ preflight_job.snapshot=s;preflight_job.scratch=w;
+ preflight_job.active=true;preflight_job.finished=preflight_job.ok=false;
+ disp_start(preflight_run,preflight_finish,true);
+ disp_join();
+ assert(preflight_job.finished);
+ bool ok=preflight_job.ok;
+ memset(&preflight_job,0,sizeof preflight_job);
+ return ok;
+}
